    <style name="Theme.GameMatrixApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/wrongbook_primary</item>
        <item name="colorPrimaryVariant">@color/wrongbook_primary_variant</item>
        <item name="colorOnPrimary">@color/wrongbook_on_primary</item>
        <item name="colorSecondary">@color/wrongbook_secondary</item>
        <item name="colorOnSecondary">@color/wrongbook_on_secondary</item>
