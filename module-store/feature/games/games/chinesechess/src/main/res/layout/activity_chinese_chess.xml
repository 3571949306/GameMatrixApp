<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4E3C3"
    android:paddingTop="24dp">

    <TextView
        android:id="@+id/tv_game_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="2"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        android:text="已选中难度 · 增强棋盘 · 可在下方重新选择"
        android:textColor="#5D4037"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:paddingVertical="5dp"
        android:textColor="#8B5A2B"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <com.gamecenter.app.chinesechess.ChineseChessView
        android:id="@+id/chess_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/difficulty_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="#FFF8E8"
        android:elevation="3dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择难度"
            android:textColor="#8B5A2B"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_difficulty_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="难度：中 (2/4)"
            android:textColor="#8B5A2B"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_difficulty_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="2"
            android:text="适合休闲对局：兼顾响应速度和基础战术。"
            android:textColor="#795548"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_difficulty_1"
                    android:stateListAnimator="@null"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:text="低"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_difficulty_2"
                    android:stateListAnimator="@null"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:text="中"
                    android:textSize="14sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_difficulty_3"
                    android:stateListAnimator="@null"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:text="高"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_difficulty_4"
                    android:stateListAnimator="@null"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:text="大师"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btn_start_game"
            android:stateListAnimator="@null"
            android:layout_width="160dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="开始游戏" />

        <CheckBox
            android:id="@+id/check_simple_board"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="开启简洁棋盘（减少坐标、木纹和动画装饰）"
            android:textColor="#5D4037"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_tutorial"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:text="新手教程" />

            <Button
                android:id="@+id/btn_online"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:text="联机" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_undo"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="悔棋"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_hint"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="提示"
                android:textSize="13sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_restart"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="重新开始"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_tutorial_ingame"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="教程"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_board_style"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="棋盘：增强"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
