<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9E4B7"
    android:paddingTop="28dp">

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:textColor="#8B5A2B"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <com.gamecenter.app.chinesechess.ChineseChessView
        android:id="@+id/chess_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/difficulty_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择难度"
            android:textColor="#8B5A2B"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_difficulty_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="难度：中 (2/4)"
            android:textColor="#8B5A2B"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_difficulty_1"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:text="低"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_difficulty_2"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:text="中"
                    android:textSize="14sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_difficulty_3"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:text="高"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_difficulty_4"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:text="大师"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btn_start_game"
            android:layout_width="160dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="开始游戏" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_tutorial"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:text="新手教程" />

            <Button
                android:id="@+id/btn_online"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:text="联机" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_undo"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="悔棋"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_hint"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="提示"
                android:textSize="13sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_restart"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="重新开始"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_tutorial_ingame"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="教程"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
