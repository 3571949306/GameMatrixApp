<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Device info card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/adb_system_device_info"
            android:textSize="12sp"
            android:textColor="@color/adb_text_secondary"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/adb_card_bg"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/adb_sys_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/adb_system_model"
                android:textSize="12sp"
                android:textColor="@color/adb_text_secondary" />

            <TextView
                android:id="@+id/adb_sys_brand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/adb_system_brand"
                android:textSize="12sp"
                android:textColor="@color/adb_text_secondary" />

            <TextView
                android:id="@+id/adb_sys_android_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/adb_system_android_version"
                android:textSize="12sp"
                android:textColor="@color/adb_text_secondary" />

            <TextView
                android:id="@+id/adb_sys_sdk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/adb_system_sdk"
                android:textSize="12sp"
                android:textColor="@color/adb_text_secondary" />

            <TextView
                android:id="@+id/adb_sys_build"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/adb_system_build"
                android:textSize="12sp"
                android:textColor="@color/adb_text_secondary" />

            <TextView
                android:id="@+id/adb_sys_serial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/adb_system_serial"
                android:textSize="12sp"
                android:textColor="@color/adb_text_secondary" />

            <TextView
                android:id="@+id/adb_sys_dpi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/adb_system_current_dpi"
                android:textSize="12sp"
                android:textColor="@color/adb_text_secondary"
                android:paddingTop="8dp" />

            <TextView
                android:id="@+id/adb_sys_resolution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/adb_system_current_resolution"
                android:textSize="12sp"
                android:textColor="@color/adb_text_secondary" />
        </LinearLayout>

        <!-- DPI control -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/adb_system_dpi"
            android:textSize="12sp"
            android:textColor="@color/adb_text_secondary"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <EditText
                android:id="@+id/adb_sys_dpi_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="320-640"
                android:inputType="number"
                android:textSize="14sp"
                android:background="@drawable/adb_input_bg" />

            <TextView
                android:id="@+id/adb_sys_dpi_apply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adb_system_apply"
                android:textSize="13sp"
                android:padding="8dp"
                android:background="@drawable/adb_button_bg"
                android:textColor="@color/adb_button_text"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/adb_sys_dpi_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adb_system_reset_default"
                android:textSize="12sp"
                android:padding="8dp"
                android:background="@drawable/adb_card_bg"
                android:textColor="@color/adb_text_primary"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Resolution control -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/adb_system_resolution"
            android:textSize="12sp"
            android:textColor="@color/adb_text_secondary"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <EditText
                android:id="@+id/adb_sys_res_w"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="宽"
                android:inputType="number"
                android:textSize="14sp"
                android:background="@drawable/adb_input_bg" />

            <EditText
                android:id="@+id/adb_sys_res_h"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="高"
                android:inputType="number"
                android:textSize="14sp"
                android:background="@drawable/adb_input_bg"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/adb_sys_res_apply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adb_system_apply"
                android:textSize="13sp"
                android:padding="8dp"
                android:background="@drawable/adb_button_bg"
                android:textColor="@color/adb_button_text"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Animation scale -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/adb_system_animation_scale"
            android:textSize="12sp"
            android:textColor="@color/adb_text_secondary"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <EditText
                android:id="@+id/adb_sys_anim_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="1.0"
                android:inputType="numberDecimal"
                android:textSize="14sp"
                android:background="@drawable/adb_input_bg" />

            <TextView
                android:id="@+id/adb_sys_anim_apply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adb_system_apply"
                android:textSize="13sp"
                android:padding="8dp"
                android:background="@drawable/adb_button_bg"
                android:textColor="@color/adb_button_text"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Reboot actions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="重启操作"
            android:textSize="12sp"
            android:textColor="@color/adb_text_secondary"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/adb_card_bg"
            android:padding="12dp">

            <TextView
                android:id="@+id/adb_sys_reboot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/adb_system_reboot"
                android:textSize="14sp"
                android:padding="10dp"
                android:background="@drawable/adb_button_bg"
                android:textColor="@color/adb_button_text"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/adb_sys_reboot_recovery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/adb_system_reboot_recovery"
                android:textSize="13sp"
                android:padding="10dp"
                android:background="@drawable/adb_card_bg"
                android:textColor="@color/adb_text_primary"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/adb_sys_reboot_bootloader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/adb_system_reboot_bootloader"
                android:textSize="13sp"
                android:padding="10dp"
                android:background="@drawable/adb_card_bg"
                android:textColor="@color/adb_text_primary"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
