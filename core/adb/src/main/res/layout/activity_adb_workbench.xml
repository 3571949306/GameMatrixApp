<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/adb_background">

    <!-- Top bar: device info and tabs -->
    <LinearLayout
        android:id="@+id/adb_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/adb_surface"
        android:elevation="2dp">

        <!-- Device info row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/adb_btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textSize="20sp"
                android:textColor="@color/adb_text_primary"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/adb_device_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/adb_topbar_no_device"
                android:textSize="14sp"
                android:textColor="@color/adb_text_secondary"
                android:ellipsize="end"
                android:singleLine="true" />

            <TextView
                android:id="@+id/adb_btn_disconnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adb_btn_disconnect"
                android:textSize="12sp"
                android:textColor="@color/adb_primary"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Tab buttons -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="4dp">

            <LinearLayout
                android:id="@+id/adb_tab_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/adb_tab_device"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/adb_tab_device"
                    android:textSize="13sp"
                    android:textColor="@color/adb_tab_selected"
                    android:textStyle="bold"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/adb_tab_bg_selected"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/adb_tab_app"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/adb_tab_app"
                    android:textSize="13sp"
                    android:textColor="@color/adb_tab_unselected"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/adb_tab_file"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/adb_tab_file"
                    android:textSize="13sp"
                    android:textColor="@color/adb_tab_unselected"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/adb_tab_shell"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/adb_tab_shell"
                    android:textSize="13sp"
                    android:textColor="@color/adb_tab_unselected"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/adb_tab_screen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/adb_tab_screen"
                    android:textSize="13sp"
                    android:textColor="@color/adb_tab_unselected"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/adb_tab_system"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/adb_tab_system"
                    android:textSize="13sp"
                    android:textColor="@color/adb_tab_unselected"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/adb_tab_fastboot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/adb_tab_fastboot"
                    android:textSize="13sp"
                    android:textColor="@color/adb_tab_unselected"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Safety notice -->
    <TextView
        android:id="@+id/adb_safety_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/adb_safety_notice"
        android:textSize="11sp"
        android:textColor="@color/adb_text_hint"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp" />

    <!-- Content area: FrameLayout hosting each section's content view -->
    <FrameLayout
        android:id="@+id/adb_content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom status bar -->
    <TextView
        android:id="@+id/adb_bottom_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="11sp"
        android:textColor="@color/adb_text_hint"
        android:background="@color/adb_surface"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp" />
</LinearLayout>
