<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Output area -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/adb_shell_output_empty"
        android:textSize="12sp"
        android:textColor="@color/adb_text_hint"
        android:paddingBottom="4dp" />

    <ScrollView
        android:id="@+id/adb_shell_output_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/adb_card_bg"
        android:padding="8dp">

        <TextView
            android:id="@+id/adb_shell_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="@color/adb_text_primary"
            android:textIsSelectable="true" />
    </ScrollView>

    <!-- Command input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/adb_shell_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/adb_shell_hint"
            android:inputType="text"
            android:textSize="13sp"
            android:background="@drawable/adb_input_bg"
            android:singleLine="true" />

        <TextView
            android:id="@+id/adb_shell_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/adb_shell_send"
            android:textSize="14sp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:background="@drawable/adb_button_bg"
            android:textColor="@color/adb_button_text"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Quick actions row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/adb_shell_history_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/adb_shell_history"
            android:textSize="12sp"
            android:gravity="center"
            android:padding="6dp"
            android:background="@drawable/adb_card_bg"
            android:textColor="@color/adb_text_secondary"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/adb_shell_shortcuts_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/adb_shell_shortcuts"
            android:textSize="12sp"
            android:gravity="center"
            android:padding="6dp"
            android:background="@drawable/adb_card_bg"
            android:textColor="@color/adb_text_secondary"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/adb_shell_clear_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="清空输出"
            android:textSize="12sp"
            android:gravity="center"
            android:padding="6dp"
            android:background="@drawable/adb_card_bg"
            android:textColor="@color/adb_text_secondary"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
