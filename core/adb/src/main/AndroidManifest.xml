<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <application>
        <!-- Host capability, not an Activity declared by a dynamically loaded APK. -->
        <activity android:name="com.gamecenter.app.adb.AdbWorkbenchActivity"
            android:exported="false" android:process=":adb"
            android:launchMode="singleTop" android:label="@string/adb_title"
            android:theme="@style/AdbWorkbenchTheme" />
        <service android:name="com.gamecenter.app.adb.AdbSessionService"
            android:exported="false" android:process=":adb"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
