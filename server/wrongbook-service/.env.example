# ============================================================
# GameMatrixApp 错题本后端服务 - 环境变量示例
# ============================================================
# 用法：
#   1. 复制本文件为 .env
#   2. 将占位符替换为真实 API 密钥
#   3. .env 文件已被 .gitignore 排除，不会被提交到 GitHub
# ============================================================

# ---------- 运行环境 ----------
APP_ENV=debug
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ---------- 百度智能云 OCR ----------
# 控制台：https://console.bce.baidu.com/ai/#/ai/ocr/overview/index
BAIDU_OCR_API_KEY=在这里填入百度智能云_API_Key
BAIDU_OCR_SECRET_KEY=在这里填入百度智能云_Secret_Key
# 默认接口：通用文字识别（标准含位置版）
BAIDU_OCR_DEFAULT_ENDPOINT=https://aip.baidubce.com/rest/2.0/ocr/v1/general
# 备用接口：通用文字识别（高精度含位置版）
BAIDU_OCR_FALLBACK_ENDPOINT=https://aip.baidubce.com/rest/2.0/ocr/v1/accurate

# ---------- 智谱 BigModel ----------
# 控制台：https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=在这里填入智谱_BigModel_API_Key
# 文本解题模型（免费）
ZHIPU_TEXT_MODEL=glm-4.7-flash
# 图片题兜底模型（后期接入）
ZHIPU_VISION_MODEL=glm-4v-flash
# 智谱对话接口
ZHIPU_CHAT_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions

# ---------- 默认策略 ----------
# OCR 提供方：baidu
OCR_PROVIDER=baidu
# OCR 模式：general_with_location / accurate_with_location
OCR_MODE=general_with_location
# AI 提供方：zhipu
AI_PROVIDER=zhipu
# AI 解题模式：normal / strict
AI_SOLVE_MODE=normal

# ---------- 安全限制 ----------
# 单张图片最大字节（5MB）
MAX_IMAGE_BYTES=5242880
# Base64 字符串最大长度（约 7MB）
MAX_BASE64_LENGTH=7340032
# 接口超时（秒）
HTTP_TIMEOUT_SECONDS=30
# 调用频率限制（每分钟）
RATE_LIMIT_PER_MINUTE=30
# Android 端访问 OCR/AI 代理时使用的共享令牌（必须替换，建议 32+ 随机字符）
WRONGBOOK_API_TOKEN=在这里填入至少32位随机访问令牌
