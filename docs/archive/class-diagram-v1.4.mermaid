classDiagram
    class ModuleManager {
        -manifests: ConcurrentHashMap<String, ModuleManifest>
        -downloadCallbacks: ConcurrentHashMap<String, Callback>
        +loadModuleList(context, callback): Unit
        +downloadModule(context, moduleId, callback): Unit
        +installModuleWithDependencies(context, moduleId): Unit
        +loadModule(context, moduleId): ModuleInterface?
        +unloadModule(context, moduleId): Unit
        +isModuleInstalled(context, moduleId): Boolean
        -loadModuleViaRePlugin(context, manifest): ModuleInterface? ❌ 删除
    }
    
    class ModuleLoaderV2 {
        -loadedModules: Map<String, IModule>
        -classLoaderCache: Map<String, DexClassLoader>
        -moduleVerifier: ModuleVerifier
        -dexCacheManager: DexCacheManager
        +loadModule(moduleInfo: ModuleInfo): IModule
        +unloadModule(moduleId: String): Unit
        +isModuleLoaded(moduleId: String): Boolean
    }
    
    class ModuleDependencyResolver {
        +resolveDependencies(manifest: ModuleManifest): List<String>
        +detectCircularDependency(moduleId: String, visited: Set<String>): Boolean
        +getHighestVersion(depId: String): ModuleManifest?
    }
    
    class ModuleDependencyDownloader {
        -moduleManager: ModuleManager
        -downloadedDeps: MutableSet<String>
        +downloadDependencies(context: Context, moduleId: String, callback: Callback): Unit
        -downloadDependency(context: Context, depId: String, callback: Callback): Unit
    }
    
    class ModuleManifest {
        +id: String
        +name: String
        +versionCode: Int
        +depends: List<String> ✅ 已有
        +type: String
        +builtIn: Boolean
        +downloadUrl: String
        +sha256: String
        +fileSize: Long
    }
    
    class ModuleDownloader {
        +downloadModule(context, manifest, callback): Unit
        +cancel(moduleId: String): Unit
        +getModuleFile(context, manifest): File
    }
    
    class RobolectricTestRunner {
        <<test>>
        +runTest(className: String): Unit
    }
    
    class ModuleLoaderV2Test {
        <<test>>
        +testLoadModule(): Unit
        +testUnloadModule(): Unit
        +testReloadModule(): Unit
    }
    
    class ModuleDependencyTest {
        <<test>>
        +testResolveDependencies(): Unit
        +testCircularDependencyDetection(): Unit
        +testDownloadDependencies(): Unit
    }
    
    ModuleManager --> ModuleLoaderV2 : 使用
    ModuleManager --> ModuleDependencyResolver : 使用 ✅ 新增
    ModuleManager --> ModuleDependencyDownloader : 使用 ✅ 新增
    ModuleDependencyDownloader --> ModuleDownloader : 使用
    ModuleManifest --> ModuleDependencyResolver : 输入
    ModuleLoaderV2Test --> ModuleLoaderV2 : 测试
    ModuleDependencyTest --> ModuleDependencyResolver : 测试
    ModuleDependencyTest --> ModuleDependencyDownloader : 测试
