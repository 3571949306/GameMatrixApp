classDiagram
    class AppCompatActivity {
        <<Android Framework>>
        +onCreate(Bundle)
        +onPause()
        +onResume()
        +onDestroy()
    }

    class BaseGameActivity {
        <<abstract>>
        -String gameId
        -GameConfig gameConfig
        -GameAchievementManager achievementManager
        -GameDifficultyManager difficultyManager
        -GameUsageStore usageStore
        #TextView tvTitle
        #TextView tvScore
        #MaterialButton btnRules
        #MaterialButton btnTutorial
        #MaterialButton btnDifficulty
        +onCreate(Bundle)*
        #initGame()*
        #startGame()*
        #pauseGame()*
        #resumeGame()*
        #endGame()*
        #checkAchievement()*
        +showRules()
        +showTutorial()
        +showDifficultyDialog()
        +updateScore(int score)
        +showAchievementPopup(AchievementData)
        #getGameConfig() GameConfig
    }

    class GameRulesFragment {
        -String gameId
        -GameConfig gameConfig
        +newInstance(String gameId)$ GameRulesFragment
        +onCreateView() View
        -loadRules()
        -setupViewPager()
    }

    class GameTutorialFragment {
        -List~TutorialStep~ steps
        -int currentStep
        -HighlightOverlayView overlayView
        +newInstance(List steps)$ GameTutorialFragment
        +onCreateView() View
        +nextStep()
        +previousStep()
        +skipTutorial()
        -showHighlight(TutorialStep)
        -animateTransition()
    }

    class GameAchievementManager {
        -String gameId
        -AchievementManager globalManager
        -List~AchievementDef~ achievementDefs
        -Map~String, float~ progressMap
        +init(String gameId, List defs)
        +checkAndUnlock(String eventType, Map params)
        +updateProgress(String key, float progress)
        +getAchievements() List~AchievementData~
        +getUnlockedCount() int
        +getTotalCount() int
        -evaluateCondition(AchievementDef, Map) boolean
    }

    class GameDifficultyManager {
        -String gameId
        -List~DifficultyLevel~ levels
        -DifficultyLevel currentLevel
        -IGameDifficulty gameDifficulty
        +init(String gameId, IGameDifficulty)
        +showDifficultyDialog(Context)
        +getCurrentLevel() DifficultyLevel
        +setDifficulty(DifficultyLevel)
        +getDefaultDifficulty() DifficultyLevel
    }

    class AchievementManager {
        <<已有 单例>>
        +getInstance(Context) AchievementManager
        +unlock(String id)
        +isUnlocked(String id) boolean
        +getAllAchievements() List
        +addListener(OnAchievementUnlockedListener)
        +removeListener(OnAchievementUnlockedListener)
    }

    class GameConfig {
        -String gameId
        -String name
        -GameType type
        -Priority priority
        -int iconResId
        -boolean hasAI
        -List~DifficultyLevel~ difficultyLevels
        -List~TutorialStep~ tutorialSteps
        -List~AchievementDef~ achievements
        -int rulesResId
        -String activityClassName
    }

    class TutorialStep {
        -int stepNumber
        -String title
        -String description
        -HighlightType highlightType
        -int targetViewId
        -Rect highlightArea
        -HighlightShape shape
        -ArrowDirection arrowDirection
        -int illustrationResId
        -boolean waitForAction
    }

    class DifficultyLevel {
        -String name
        -int level
        -String description
        -int aiSearchDepth
        -long aiResponseDelayMs
        -float difficultyFactor
        -boolean isDefault
    }

    class AchievementDef {
        -String key
        -int nameResId
        -int descriptionResId
        -AchievementLevel level
        -ConditionType conditionType
        -int threshold
        -boolean hidden
    }

    class AchievementData {
        -String id
        -String name
        -String description
        -AchievementLevel level
        -String gameId
        -boolean unlocked
        -String unlockedAt
        -float progress
    }

    class AchievementLevel {
        <<enum>>
        BRONZE
        SILVER
        GOLD
        EASTER_EGG
    }

    class IAchievementCallback {
        <<interface>>
        +onAchievementUnlocked(AchievementData)
        +onAchievementProgress(String, float)
        +getGameId() String
    }

    class IGameTutorial {
        <<interface>>
        +getTutorialSteps() List~TutorialStep~
        +onTutorialStart()
        +onTutorialStepChanged(int, TutorialStep)
        +onTutorialCompleted(boolean)
        +showCustomTutorial() boolean
    }

    class IGameDifficulty {
        <<interface>>
        +getDifficultyLevels() List~DifficultyLevel~
        +getCurrentDifficulty() DifficultyLevel
        +setDifficulty(DifficultyLevel)
        +onDifficultyChanged(DifficultyLevel, DifficultyLevel)
    }

    class IGameAI {
        <<interface>>
        +calculateNextMove(Object, DifficultyLevel, AIMoveCallback)
        +isCalculating() boolean
        +cancelCalculation()
    }

    class HighlightOverlayView {
        -Rect targetArea
        -HighlightShape shape
        -Paint overlayPaint
        -Paint clearPaint
        +setHighlightArea(Rect, HighlightShape)
        +animateHighlight()
        +clearHighlight()
    }

    class AchievementPopupView {
        -AchievementData achievement
        +show(View parent, AchievementData)
        +dismiss()
        -animateSlideIn()
        -animateSlideOut()
    }

    class GameConfigLoader {
        +loadGameConfig(Context, String) GameConfig
        +loadAllConfigs(Context) List~GameConfig~
        -parseJson(String) GameConfig
    }

    AppCompatActivity <|-- BaseGameActivity
    BaseGameActivity --> GameAchievementManager : 拥有
    BaseGameActivity --> GameDifficultyManager : 拥有
    BaseGameActivity --> GameConfig : 使用
    BaseGameActivity --> GameUsageStore : 使用
    BaseGameActivity ..|> IAchievementCallback : 实现
    BaseGameActivity ..|> IGameTutorial : 实现
    BaseGameActivity ..|> IGameDifficulty : 实现

    GameAchievementManager --> AchievementManager : 委托
    GameAchievementManager --> AchievementDef : 管理
    GameAchievementManager --> AchievementData : 生成
    GameAchievementManager ..|> IAchievementCallback : 调用

    GameDifficultyManager --> DifficultyLevel : 管理
    GameDifficultyManager ..|> IGameDifficulty : 调用

    GameConfig --> DifficultyLevel : 包含
    GameConfig --> TutorialStep : 包含
    GameConfig --> AchievementDef : 包含

    GameRulesFragment --> GameConfig : 使用
    GameTutorialFragment --> TutorialStep : 管理
    GameTutorialFragment --> HighlightOverlayView : 使用

    AchievementDef --> AchievementLevel : 引用
    AchievementData --> AchievementLevel : 引用
