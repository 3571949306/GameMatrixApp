classDiagram
    %% 框架层
    class App {
        -ModuleLifecycleManager lifecycleManager
        -ModuleDependencyGraph dependencyGraph
        +onCreate()
        +getModuleManager() ModuleManager
    }

    class ModuleLifecycleManager {
        -Map~String, Module~ loadedModules
        -ModuleLoaderV2 moduleLoader
        +loadModule(moduleId: String) Module
        +unloadModule(moduleId: String)
        +reloadModule(moduleId: String)
    }

    class ModuleDependencyGraph {
        -Map~String, List~String~~ dependencies
        +addDependency(moduleId: String, dependsOn: List~String~)
        +getLoadOrder(moduleId: String) List~String~
        +checkCircularDependency() boolean
    }

    %% 模块加载器
    class ModuleLoaderV2 {
        -DexCacheManager dexCacheManager
        -ModuleVerifier verifier
        -ModuleResourceLoader resourceLoader
        +loadModule(apkPath: File, moduleInfo: ModuleInfo) Module
        +unloadModule(moduleId: String)
        +checkUpdate(moduleId: String) ModuleVersion
    }

    class ModuleVerifier {
        +verifySignature(apkFile: File) boolean
        +verifyIntegrity(apkFile: File, expectedSha256: String) boolean
        +verifyCompatibility(moduleInfo: ModuleInfo) boolean
    }

    class DexCacheManager {
        -File cacheDir
        +optimizeDex(apkFile: File) File
        +clearCache(moduleId: String)
        +getCacheSize() long
    }

    class ModuleResourceLoader {
        +loadResources(apkFile: File) Resources
        +loadDrawable(apkFile: File, resId: int) Drawable
        +loadLayout(apkFile: File, layoutId: int) View
    }

    class ModuleHotReloader {
        +checkHotReload(moduleId: String) boolean
        +performHotReload(moduleId: String)
    }

    %% 模块商店
    class ModuleDownloadManager {
        -OkHttpClient httpClient
        -Map~String, DownloadTask~ activeDownloads
        +downloadModule(module: ModuleInfo, callback: DownloadCallback)
        +pauseDownload(moduleId: String)
        +resumeDownload(moduleId: String)
    }

    class ModuleInstaller {
        +installModule(apkFile: File, moduleInfo: ModuleInfo) boolean
        +installBuiltInModule(moduleInfo: ModuleInfo) boolean
        +rollbackInstall(moduleId: String)
    }

    class ModuleUninstaller {
        +uninstallModule(moduleId: String) boolean
        +preserveUserData(moduleId: String)
        +cleanupModuleData(moduleId: String)
    }

    class BuiltInModuleUpdater {
        -Map~String, ModuleInfo~ builtInModules
        +checkBuiltInUpdate(moduleId: String) ModuleVersion
        +downloadUpdate(moduleId: String, callback: DownloadCallback)
        +applyUpdate(moduleId: String) boolean
    }

    %% 数据模型
    class ModuleInfo {
        +String moduleId
        +String moduleName
        +String versionName
        +int versionCode
        +String type
        +boolean builtIn
        +List~String~ dependencies
        +String downloadUrl
        +long fileSize
        +String sha256
        +String storeCategory
    }

    class ModuleDependency {
        +String moduleId
        +String dependsOn
        +String minVersion
        +String maxVersion
    }

    class ModuleVersion {
        +String versionName
        +int versionCode
        +String changelog
        +String downloadUrl
        +long fileSize
        +String sha256
        +Date releaseDate
    }

    class UpdatePolicy {
        +String moduleId
        +boolean autoUpdate
        +boolean allowPrerelease
        +String updateChannel
        +int maxRetries
    }

    %% 联机模块
    class OnlineCoreModule {
        +OnlineRoomManager roomManager
        +GameSocketServer socketServer
        +GameSocketClient socketClient
        +RelayHttpClient relayClient
        +initialize(context: Context)
        +getRoomManager() OnlineRoomManager
    }

    class OnlineRoomManager {
        +createRoom(config: RoomConfig)
        +joinRoom(roomId: String)
        +leaveRoom()
        +sendMessage(message: String)
    }

    %% 关系
    App --> ModuleLifecycleManager
    App --> ModuleDependencyGraph
    ModuleLifecycleManager --> ModuleLoaderV2
    ModuleLoaderV2 --> ModuleVerifier
    ModuleLoaderV2 --> DexCacheManager
    ModuleLoaderV2 --> ModuleResourceLoader
    ModuleLoaderV2 --> ModuleHotReloader

    ModuleDownloadManager --> ModuleInstaller
    ModuleInstaller --> ModuleUninstaller
    BuiltInModuleUpdater --> ModuleDownloadManager

    ModuleInfo --> ModuleDependency
    ModuleInfo --> ModuleVersion
    ModuleInfo --> UpdatePolicy

    OnlineCoreModule --> OnlineRoomManager
