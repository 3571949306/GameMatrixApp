package com.gamecenter.app.modules;

import android.content.Context;
import android.os.Looper;
import androidx.test.core.app.ApplicationProvider;
import com.gamecenter.app.models.ModuleManifest;
import org.junit.After;
import org.junit.Before;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.robolectric.RobolectricTestRunner;
import org.robolectric.annotation.Config;
import org.robolectric.shadows.ShadowLooper;

import java.io.File;
import java.util.concurrent.CountDownLatch;
import java.util.concurrent.TimeUnit;

import static org.junit.Assert.*;

/**
 * ModuleDownloader 单元测试。
 *
 * <p>测试模块下载器的核心功能：
 * <ul>
 *   <li>模块下载</li>
 *   <li>下载失败处理</li>
 *   <li>取消下载</li>
 *   <li>下载进度回调</li>
 * </ul>
 *
 * @author QA Engineer (Yan Guoguan)
 * @version 1.0
 * @since 2026-05-27
 */
@RunWith(RobolectricTestRunner.class)
@Config(sdk = {28, 29, 30, 31, 32, 33, 34, 35})
public class ModuleDownloaderTest {

    private Context context;
    private ModuleManifest testManifest;
    private File modulesDir;

    @Before
    public void setUp() {
        context = ApplicationProvider.getApplicationContext();
        modulesDir = new File(context.getFilesDir(), "modules");
        if (!modulesDir.exists()) {
            modulesDir.mkdirs();
        }

        // 创建测试用的 ModuleManifest
        testManifest = new ModuleManifest();
        testManifest.id = "test_module";
        testManifest.name = "Test Module";
        testManifest.versionCode = 100;
        testManifest.versionName = "1.0.0";
        testManifest.type = "game";
        testManifest.builtIn = false;
        testManifest.downloadUrl = "https://example.com/test_module.apk";
        testManifest.sha256 = ""; // 空 SHA-256，测试应该拒绝
        testManifest.fileSize = 1024L;
        testManifest.depends = new java.util.ArrayList<>();
    }

    @After
    public void tearDown() {
        // 清理测试文件
        if (modulesDir.exists()) {
            File[] files = modulesDir.listFiles();
            if (files != null) {
                for (File file : files) {
                    file.delete();
                }
            }
        }
        // 取消所有下载
        ModuleDownloader.INSTANCE.cancelAll();
        ShadowLooper.idleMainLooper();
    }

    /**
     * 测试模块下载 - SHA-256 为空时应拒绝。
     *
     * <p>安全加固：sha256 为空时直接拒绝，不允许绕过校验。
     */
    @Test
    public void testDownloadModule() throws InterruptedException {
        final boolean[] onErrorCalled = {false};
        final String[] errorMessage = {null};
        CountDownLatch latch = new CountDownLatch(1);

        // SHA-256 为空，应该触发 onError
        ModuleDownloader.INSTANCE.downloadModule(context, testManifest, new ModuleDownloader.Callback() {
            @Override
            public void onProgress(String moduleId, long downloaded, long total, long speedKbps) {
                // 不应该被调用
            }

            @Override
            public void onComplete(String moduleId, File file) {
                // 不应该被调用（因为 SHA-256 为空）
            }

            @Override
            public void onError(String moduleId, String message) {
                onErrorCalled[0] = true;
                errorMessage[0] = message;
                latch.countDown();
            }

            @Override
            public void onSourceSwitch(String moduleId, int sourceIndex, String url) {
                // 可能不会被调用
            }
        });

        latch.await(3, TimeUnit.SECONDS);
        ShadowLooper.idleMainLooper();

        assertTrue("应该触发 onError（SHA-256 为空）", onErrorCalled[0]);
        assertNotNull("错误信息不应为 null", errorMessage[0]);
        assertTrue("错误信息应包含 'sha256' 或 'SHA-256'",
                errorMessage[0].toLowerCase().contains("sha256") ||
                errorMessage[0].toLowerCase().contains("安全"));
    }

    /**
     * 测试下载失败 - 无效的下载 URL。
     *
     * <p>当所有下载源都失败时，应该触发 onError。
     */
    @Test
    public void testDownloadModuleFailed() throws InterruptedException {
        final boolean[] onErrorCalled = {false};
        CountDownLatch latch = new CountDownLatch(1);

        // 设置无效的下载 URL
        testManifest.downloadUrl = "";
        testManifest.backupUrl = "";

        ModuleDownloader.INSTANCE.downloadModule(context, testManifest, new ModuleDownloader.Callback() {
            @Override
            public void onProgress(String moduleId, long downloaded, long total, long speedKbps) {
                // 不应该被调用
            }

            @Override
            public void onComplete(String moduleId, File file) {
                // 不应该被调用
            }

            @Override
            public void onError(String moduleId, String message) {
                onErrorCalled[0] = true;
                latch.countDown();
            }

            @Override
            public void onSourceSwitch(String moduleId, int sourceIndex, String url) {
                // 可能不会被调用
            }
        });

        latch.await(3, TimeUnit.SECONDS);
        ShadowLooper.idleMainLooper();

        assertTrue("应该触发 onError（无效 URL）", onErrorCalled[0]);
    }

    /**
     * 测试取消下载。
     *
     * <p>调用 cancel() 后，下载应该停止并触发 onError。
     */
    @Test
    public void testCancelDownload() throws InterruptedException {
        final boolean[] onErrorCalled = {false};
        final String[] cancelMessage = {null};
        CountDownLatch latch = new CountDownLatch(1);

        // 设置一个有效的 URL（但会失败）
        testManifest.downloadUrl = "https://httpstat.us/200?sleep=5000";
        testManifest.sha256 = "dummy"; // 设置假 SHA-256

        ModuleDownloader.Callback callback = new ModuleDownloader.Callback() {
            @Override
            public void onProgress(String moduleId, long downloaded, long total, long speedKbps) {
                // 取消下载
                ModuleDownloader.INSTANCE.cancel("test_module");
            }

            @Override
            public void onComplete(String moduleId, File file) {
                // 不应该被调用
            }

            @Override
            public void onError(String moduleId, String message) {
                onErrorCalled[0] = true;
                cancelMessage[0] = message;
                latch.countDown();
            }

            @Override
            public void onSourceSwitch(String moduleId, int sourceIndex, String url) {
                // 可能不会被调用
            }
        };

        ModuleDownloader.INSTANCE.downloadModule(context, testManifest, callback);

        latch.await(5, TimeUnit.SECONDS);
        ShadowLooper.idleMainLooper();

        assertTrue("应该触发 onError（下载取消）", onErrorCalled[0]);
        assertNotNull("取消消息不应为 null", cancelMessage[0]);
    }

    /**
     * 测试获取模块文件。
     *
     * <p>getModuleFile() 应该返回正确的模块文件路径。
     */
    @Test
    public void testGetModuleFile() {
        File moduleFile = ModuleDownloader.INSTANCE.getModuleFile(context, testManifest);

        assertNotNull("模块文件不应为 null", moduleFile);
        assertEquals("模块文件名应为 test_module.apk",
                "test_module.apk", moduleFile.getName());
        assertTrue("模块文件应位于 modules 目录下",
                moduleFile.getAbsolutePath().contains("modules"));
    }

    /**
     * 测试获取模块目录。
     *
     * <p>getModuleDir() 应该返回 modules 目录。
     */
    @Test
    public void testGetModuleDir() {
        File moduleDir = ModuleDownloader.INSTANCE.getModuleDir(context);

        assertNotNull("模块目录不应为 null", moduleDir);
        assertEquals("目录名应为 modules", "modules", moduleDir.getName());
        assertTrue("目录应存在或可被创建", moduleDir.exists() || moduleDir.mkdirs());
    }

    /**
     * 测试重复下载同一模块（应该被跳过）。
     *
     * <p>如果模块正在下载中，再次调用 downloadModule() 应该立即触发 onError。
     */
    @Test
    public void testDuplicateDownload() throws InterruptedException {
        final int[] errorCount = {0};
        CountDownLatch latch = new CountDownLatch(2);

        testManifest.downloadUrl = "https://httpstat.us/200?sleep=5000";
        testManifest.sha256 = "dummy";

        ModuleDownloader.Callback callback = new ModuleDownloader.Callback() {
            @Override
            public void onProgress(String moduleId, long downloaded, long total, long speedKbps) {
            }

            @Override
            public void onComplete(String moduleId, File file) {
            }

            @Override
            public void onError(String moduleId, String message) {
                errorCount[0]++;
                latch.countDown();
            }

            @Override
            public void onSourceSwitch(String moduleId, int sourceIndex, String url) {
            }
        };

        // 第一次下载
        ModuleDownloader.INSTANCE.downloadModule(context, testManifest, callback);

        // 等待一小段时间，确保第一次下载已经开始
        Thread.sleep(500);

        // 第二次下载（应该被拒绝）
        ModuleDownloader.INSTANCE.downloadModule(context, testManifest, callback);

        latch.await(3, TimeUnit.SECONDS);
        ShadowLooper.idleMainLooper();

        assertEquals("应该触发 2 次 onError（第二次下载被拒绝）", 2, errorCount[0]);
    }

    /**
     * 测试取消所有下载。
     */
    @Test
    public void testCancelAll() throws InterruptedException {
        final boolean[] onErrorCalled = {false};
        CountDownLatch latch = new CountDownLatch(1);

        testManifest.downloadUrl = "https://httpstat.us/200?sleep=5000";
        testManifest.sha256 = "dummy";

        ModuleDownloader.INSTANCE.downloadModule(context, testManifest, new ModuleDownloader.Callback() {
            @Override
            public void onProgress(String moduleId, long downloaded, long total, long speedKbps) {
                // 取消所有下载
                ModuleDownloader.INSTANCE.cancelAll();
            }

            @Override
            public void onComplete(String moduleId, File file) {
            }

            @Override
            public void onError(String moduleId, String message) {
                onErrorCalled[0] = true;
                latch.countDown();
            }

            @Override
            public void onSourceSwitch(String moduleId, int sourceIndex, String url) {
            }
        });

        latch.await(5, TimeUnit.SECONDS);
        ShadowLooper.idleMainLooper();

        assertTrue("应该触发 onError（取消所有下载）", onErrorCalled[0]);
    }
}
