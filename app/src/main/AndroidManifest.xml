<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- GNSS status is requested only when the user starts the Satellite tool.
         The app never requests background location and does not read coordinates there. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 14+ 部分照片访问权限：用户可选择只授权部分照片（READ_MEDIA_VISUAL_USER_SELECTED） -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 13+ 通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 浏览器手势导航触觉反馈 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 悬浮性能监控：TYPE_APPLICATION_OVERLAY 全局悬浮窗 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- Keep the application installable on Wi-Fi-only tablets and emulators. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <package android:name="com.netease.mobimail" />
        <package android:name="com.android.email" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.microsoft.office.outlook" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.GameMatrixApp"
        tools:targetApi="35">

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.gamecenter.app.initializers.NetworkInitializer"
                android:value="androidx.startup" />
        </provider>

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.GameMatrixApp.Splash"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.GameMatrixApp" />

        <!-- P3-11: 新手引导（首次启动） -->
        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.GameMatrixApp" />

        <activity
            android:name=".DynamicGameActivity"
            android:exported="false"
            android:theme="@style/Theme.GameMatrixApp"
            android:screenOrientation="portrait" />

        <!-- 2026-08-29 模块热更改造：26 个游戏宿主 Activity 声明已删除，
             全部游戏统一经 DynamicGameActivity 加载外置模块 APK（支持单独热更）；
             breakout 为唯一保留的宿主内置游戏（无模块 APK，走 GameRegistry 静态 Entry） -->
        <activity android:name=".games.breakout.BreakoutActivity" android:exported="false" android:theme="@style/Theme.GameMatrixApp" android:screenOrientation="portrait" />

        <activity android:name=".games.StatsActivity" android:exported="false" android:theme="@style/Theme.GameMatrixApp" android:screenOrientation="portrait" />
        <!-- P0-1 (LEADERBOARD): 本地排行榜 -->
        <activity android:name=".games.LeaderboardActivity" android:exported="false" android:theme="@style/Theme.GameMatrixApp" android:screenOrientation="portrait" />
        <!-- P0-2 (FAVORITE_GROUPS): 收藏分组管理 -->
        <activity android:name=".games.FavoriteGroupsActivity" android:exported="false" android:theme="@style/Theme.GameMatrixApp" android:screenOrientation="portrait" />
        <!-- 2026-08-29 模块热更改造：26 个游戏宿主 Activity 声明已删除，
             全部游戏统一经 DynamicGameActivity 加载外置模块 APK（支持单独热更）；
             breakout 为唯一保留的宿主内置游戏（无模块 APK，走 GameRegistry 静态 Entry） -->

        <!-- 浏览器模块 -->
        <activity android:name=".browser.ui.BrowserActivity" android:exported="false" android:theme="@style/Theme.GameMatrixApp" android:screenOrientation="unspecified" />
        <activity android:name=".browser.ui.HistoryActivity" android:exported="false" android:theme="@style/Theme.GameMatrixApp" android:screenOrientation="portrait" />
        <activity android:name=".browser.ui.BookmarkActivity" android:exported="false" android:theme="@style/Theme.GameMatrixApp" android:screenOrientation="portrait" />
        <activity android:name=".browser.ui.ReadingListActivity" android:exported="false" android:theme="@style/Theme.GameMatrixApp" android:screenOrientation="portrait" />
        <activity android:name=".browser.ui.PrivacyDashboardActivity" android:exported="false" android:theme="@style/Theme.GameMatrixApp" android:screenOrientation="portrait" />
        <activity android:name=".browser.ui.OfflineCacheActivity" android:exported="false" android:theme="@style/Theme.GameMatrixApp" android:screenOrientation="portrait" />
        <activity android:name=".browser.ui.BottomBarCustomizeActivity" android:exported="false" android:theme="@style/Theme.GameMatrixApp" android:screenOrientation="portrait" />
        <activity android:name=".browser.ui.DownloadActivity" android:exported="false" android:theme="@style/Theme.GameMatrixApp" android:screenOrientation="portrait" />
        <activity android:name=".browser.ui.TabManagerActivity" android:exported="false" android:theme="@style/Theme.GameMatrixApp" android:screenOrientation="portrait" />
        <activity android:name=".browser.ui.BrowserSettingsActivity" android:exported="false" android:theme="@style/Theme.GameMatrixApp" android:screenOrientation="portrait" />

        <activity
            android:name=".recovery.RecoveryActivity"
            android:exported="false"
            android:theme="@style/Theme.GameMatrixApp"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.GameMatrixApp"
            android:screenOrientation="portrait" />

        <!-- Phase 1 Compose 试点：设置页 Compose 版（与 .SettingsActivity 并存） -->
        <activity
            android:name=".settings.SettingsComposeActivity"
            android:exported="false"
            android:theme="@style/Theme.GameMatrixApp"
            android:screenOrientation="portrait" />

        <!-- 首页重写试点：Compose 版首页（与 .GamesFragment 并存） -->
        <activity
            android:name=".home.HomeComposeActivity"
            android:exported="false"
            android:theme="@style/Theme.GameMatrixApp"
            android:screenOrientation="portrait" />

        <!-- #23 数据与连接中心：聚合展示本地数据/网络/同步状态，支持一键导出/删除 -->
        <activity
            android:name=".settings.DataConnectionCenterActivity"
            android:exported="false"
            android:theme="@style/Theme.GameMatrixApp"
            android:screenOrientation="portrait" />

        <activity
            android:name=".settings.BottomNavigationSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.GameMatrixApp"
            android:screenOrientation="portrait" />

        <activity
            android:name=".games.achievement.AchievementCenterActivity"
            android:exported="false"
            android:theme="@style/Theme.GameMatrixApp"
            android:screenOrientation="portrait" />

        <!-- Batch 9-3 (ACHIEVEMENT_DETAIL_PAGE): 单游戏成就详情页 -->
        <activity
            android:name=".games.achievement.AchievementDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.GameMatrixApp"
            android:screenOrientation="portrait" />

        <!-- Batch 9-1 (GAME_LONG_PRESS_MENU): 接收桌面快捷方式创建结果（静默，无 UI） -->
        <receiver
            android:name=".ui.GameLongPressMenu$ShortcutResultReceiver"
            android:exported="false" />

        <activity
            android:name=".modules.ModuleStoreActivity"
            android:exported="false"
            android:theme="@style/Theme.GameMatrixApp"
            android:screenOrientation="portrait" />

        <activity
            android:name=".modules.bridge.FlutterModuleStoreActivity"
            android:exported="false"
            android:theme="@style/Theme.GameMatrixApp"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|locale|layoutDirection|fontScale|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".modules.InstalledModulesActivity"
            android:exported="false"
            android:theme="@style/Theme.GameMatrixApp"
            android:screenOrientation="portrait" />

        <activity
            android:name=".modules.runtime.WebModuleActivity"
            android:exported="false"
            android:theme="@style/Theme.GameMatrixApp"
            android:screenOrientation="unspecified" />

        <!-- P6: Unity 模块占位启动 Activity -->
        <activity
            android:name=".modules.unity.UnityPlayerPlaceholderActivity"
            android:exported="false"
            android:theme="@style/Theme.GameMatrixApp"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.browser.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.wrongbook.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 恢复模式用于通过 FileProvider 安装稳定版 APK（RecoveryInstaller） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.update.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name="com.gamecenter.app.vpn.service.VpnServiceProxy"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

    </application>

</manifest>
