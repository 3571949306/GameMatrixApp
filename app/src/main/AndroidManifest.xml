<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <package android:name="com.netease.mobimail" />
        <package android:name="com.android.email" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.microsoft.office.outlook" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.GameCenterApp"
        android:usesCleartextTraffic="true"
        tools:targetApi="35">

        <!-- App Startup 初始化器 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.gamecenter.app.initializers.NetworkInitializer"
                android:value="androidx.startup" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GameCenterApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".games.gomoku.GomokuActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />

        <activity
            android:name=".games.go.GoActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />

        <activity
            android:name=".games.chinesechess.ChineseChessActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />

        <activity
            android:name=".games.snake.SnakeActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />

        <activity
            android:name=".games.tetris.TetrisActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />

        <activity
            android:name=".games.brotato.BrotatoActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />

        <!-- 斗地主菜单 - 竖屏显示 -->
        <activity
            android:name=".games.doudizhu.DouDiZhuMenuActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />

        <!-- 斗地主单机游戏 - 横屏 -->
        <activity
            android:name=".games.doudizhu.DouDiZhuActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="landscape" />

        <!-- 斗地主联机模式 - 横屏 -->
        <activity
            android:name=".games.doudizhu.DouDiZhuOnlineActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="landscape" />

        <activity
            android:name=".games.game2048.Game2048Activity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.sudoku.SudokuActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.sokoban.SokobanActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.pipeline.PipelineActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.klotski.KlotskiActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.breakout.BreakoutActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.whack.WhackActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.match.MatchActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.blackjack.BlackjackActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.checkers.CheckersActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.flappy.FlappyActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.tiles.TilesActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.plane.PlaneActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.rock.RockActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.rock.RockOnlineActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.gomoku.GomokuOnlineActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.chinesechess.ChineseChessOnlineActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.go.GoOnlineActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.tic.TicActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.memory.MemoryActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.guess.GuessActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.dice.DiceActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.reaction.ReactionActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />

        <activity
            android:name=".games.StatsActivity"
            android:exported="false"
            android:theme="@style/Theme.GameCenterApp"
            android:screenOrientation="portrait" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.update.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
