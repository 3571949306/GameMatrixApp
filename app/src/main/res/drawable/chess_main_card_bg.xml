<?xml version="1.0" encoding="utf-8"?>
<!-- 中国象棋主页中央卡片背景：木纹渐变 + 圆角 + 边框 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="@color/chess_card_bg"
        android:endColor="@color/chess_card_bg_end"
        android:angle="135" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/chess_card_border" />
</shape>
