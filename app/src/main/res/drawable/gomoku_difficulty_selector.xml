<?xml version="1.0" encoding="utf-8"?>
<!-- 五子棋难度按钮selector：选中深棕填充白字，未选中浅棕填充深字 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gomoku_difficulty_selected" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/gomoku_card_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gomoku_difficulty_unselected_bg" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
