<?xml version="1.0" encoding="utf-8"?>
<!-- 底部导航图标颜色选择器 -->
<!-- 普通状态：colorOnSurfaceVariant -->
<!-- 选中状态：brand_primary（00D9FF） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <color android:color="@color/brand_primary" />
    </item>
    <item>
        <color android:color="?attr/colorOnSurfaceVariant" />
    </item>
</selector>
