    <!-- 游戏规则 -->
    <string name="game_brotato_rules_title">土豆兄弟规则</string>
    <string name="game_brotato_rules_content">
        1. 滑动手指控制土豆角色移动\n
        2. 角色会自动朝最近的敌人射击\n
        3. 消灭所有敌人完成一波\n
        4. 被敌人碰到会失去生命\n
        5. 每波结束恢复3点生命\n
        6. 波次递增，敌人更多更强\n
        7. 生存越久，得分越高！
    </string>

