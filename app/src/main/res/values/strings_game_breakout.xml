    <!-- 游戏规则 -->
    <string name="game_breakout_rules_title">打砖块规则</string>
    <string name="game_breakout_rules_content">
        1. 移动手指控制底部挡板\n
        2. 球会从挡板反弹\n
        3. 用球消除上方所有砖块\n
        4. 球掉出底部会失去一条命（共3条）\n
        5. 消除所有砖块即过关\n
        6. 随着关卡提升，砖块更多、球速更快
    </string>

