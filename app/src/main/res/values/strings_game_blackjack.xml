    <!-- 游戏规则 -->
    <string name="game_blackjack_rules_title">21点规则</string>
    <string name="game_blackjack_rules_content">
        1. 目标：使手牌点数接近21点但不超过\n
        2. A算1或11，JQK算10，其他按面值\n
        3. \"要牌\"再拿一张，\"停牌\"停止\n
        4. 超过21点则\"爆牌\"自动输\n
        5. 庄家点数小于17必须继续要牌\n
        6. 首两张为A+10点牌=Blackjack！
    </string>

