    <!-- 游戏规则 -->
    <string name="game_guess_rules_title">猜数字规则</string>
    <string name="game_guess_rules_content">
        1. 系统生成一个随机数字\n
        2. 输入你的猜测，系统会提示\"大了\"或\"小了\"\n
        3. 根据提示缩小范围，直到猜中\n
        4. 猜测次数越少，得分越高\n
        5. 每3局难度递增（范围扩大）
    </string>

