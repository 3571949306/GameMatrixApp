    <!-- 游戏规则 -->
    <string name="game_go_rules_title">围棋规则（简化版）</string>
    <string name="game_go_rules_content">
        1. 9×9简化围棋棋盘，黑棋先行\n
        2. 轮流在交叉点落子\n
        3. 连续同色棋子形成"棋串"，无气（相邻空点）的棋串被提走\n
        4. 禁止自杀（落子后自身无气且未提子）\n
        5. 禁止劫争（不能立刻回提单子）\n
        6. 双方都虚着（Pass）则终局\n
        7. 终局计算领地，黑棋贴6.5目\n
        8. 领地多者获胜
    </string>

