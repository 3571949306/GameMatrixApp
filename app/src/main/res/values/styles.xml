<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ========== GameMatrix 全局组件样式 — Google Play 简约风 ========== -->

    <!-- 主按钮 -->
    <style name="Widget.GameMatrix.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">44dp</item>
        <item name="minHeight">44dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- 色调按钮 -->
    <style name="Widget.GameMatrix.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">36dp</item>
        <item name="minHeight">36dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- 描边按钮 -->
    <style name="Widget.GameMatrix.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">36dp</item>
        <item name="minHeight">36dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- 文字按钮 -->
    <style name="Widget.GameMatrix.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">32dp</item>
        <item name="minHeight">32dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- 图标按钮 -->
    <style name="Widget.GameMatrix.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="iconSize">20dp</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- FAB -->
    <style name="Widget.GameMatrix.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="elevation">@dimen/gm_elevation_2</item>
        <item name="pressedTranslationZ">@dimen/gm_elevation_3</item>
    </style>

    <!-- 卡片 — 无描边、微妙阴影（A2: 圆角/阴影引用 token） -->
    <style name="Widget.GameMatrix.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/gm_radius_lg</item>
        <item name="cardElevation">@dimen/gm_elevation_1</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">?attr/colorPrimaryContainer</item>
    </style>

    <!-- 游戏卡片 — 稍大圆角 -->
    <style name="Widget.GameMatrix.Card.Game" parent="Widget.GameMatrix.Card">
        <item name="cardCornerRadius">@dimen/gm_radius_xl</item>
        <item name="cardElevation">@dimen/gm_elevation_2</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">?attr/colorPrimaryContainer</item>
    </style>

    <!-- 模块卡片 -->
    <style name="Widget.GameMatrix.Card.Module" parent="Widget.GameMatrix.Card">
        <item name="cardCornerRadius">@dimen/gm_radius_md</item>
        <item name="cardElevation">@dimen/gm_elevation_1</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- 搜索框（A2: 圆角引用 token） -->
    <style name="Widget.GameMatrix.Search" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusBottomEnd">@dimen/gm_radius_xl</item>
        <item name="boxCornerRadiusBottomStart">@dimen/gm_radius_xl</item>
        <item name="boxCornerRadiusTopEnd">@dimen/gm_radius_xl</item>
        <item name="boxCornerRadiusTopStart">@dimen/gm_radius_xl</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxBackgroundColor">?attr/colorSurfaceVariant</item>
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="startIconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Tab -->
    <style name="Widget.GameMatrix.Tab" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
        <item name="tabSelectedTextColor">?attr/colorPrimary</item>
        <item name="tabTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="tabTextAppearance">@style/TextAppearance.GameMatrix.Tab</item>
        <item name="tabRippleColor">?attr/colorPrimaryContainer</item>
    </style>

    <!-- Chip（A2: 圆角引用 token） -->
    <style name="Widget.GameMatrix.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/gm_radius_sm</item>
        <item name="chipMinHeight">28dp</item>
        <item name="textStartPadding">12dp</item>
        <item name="textEndPadding">12dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.GameMatrix.Chip.Assist" parent="Widget.Material3.Chip.Assist">
        <item name="chipCornerRadius">6dp</item>
        <item name="chipMinHeight">24dp</item>
        <item name="textStartPadding">8dp</item>
        <item name="textEndPadding">8dp</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- 文本样式 -->
    <style name="TextAppearance.GameMatrix.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.GameMatrix.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.GameMatrix.Tab" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.GameMatrix.CardTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.GameMatrix.CardDesc" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- 平台按钮兼容 -->
    <style name="Widget.GameMatrix.PlatformButton" parent="@android:style/Widget.Material.Button">
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- 兼容桥接 -->
    <style name="ShapeAppearance" />
    <style name="Widget.Material3.Button.Tonal" parent="Widget.Material3.Button.TonalButton" />

    <!-- Feature D (VISUAL_REFRESH): 底部导航选中态圆角胶囊指示器 -->
    <style name="ShapeAppearance.GameMatrix.NavIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <!-- Batch 6 (NAV_ACTIVE_ANIM): 选中态胶囊增强 —— 更高、更圆、带阴影 -->
    <style name="Widget.GameMatrix.BottomNavigationView.ActiveIndicator"
           parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:height">36dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.GameMatrix.NavIndicator</item>
        <item name="backgroundTint">@color/bottom_nav_selected_bg</item>
        <item name="android:elevation">3dp</item>
    </style>

</resources>
