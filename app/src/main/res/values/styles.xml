<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ========== GameMatrix 全局组件样式 ========== -->

    <!-- 主按钮 - 填充样式 -->
    <style name="Widget.GameMatrix.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="minHeight">48dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:includeFontPadding">true</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 色调按钮 - 次级操作 -->
    <style name="Widget.GameMatrix.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">40dp</item>
        <item name="minHeight">40dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:includeFontPadding">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- 描边按钮 -->
    <style name="Widget.GameMatrix.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">40dp</item>
        <item name="minHeight">40dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:includeFontPadding">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- 文字按钮 -->
    <style name="Widget.GameMatrix.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">36dp</item>
        <item name="minHeight">36dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- 图标按钮 - 圆形 -->
    <style name="Widget.GameMatrix.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="iconSize">20dp</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
    </style>

    <!-- 浮动操作按钮 FAB -->
    <style name="Widget.GameMatrix.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="elevation">6dp</item>
        <item name="pressedTranslationZ">10dp</item>
    </style>

    <!-- 卡片样式 -->
    <style name="Widget.GameMatrix.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">?attr/colorPrimary</item>
    </style>

    <!-- 游戏卡片 - 带发光边框 -->
    <style name="Widget.GameMatrix.Card.Game" parent="Widget.GameMatrix.Card">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">6dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/card_glow_primary</item>
        <item name="rippleColor">?attr/colorPrimaryContainer</item>
    </style>

    <!-- 模块卡片 -->
    <style name="Widget.GameMatrix.Card.Module" parent="Widget.GameMatrix.Card">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">3dp</item>
        <item name="strokeWidth">0.5dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
    </style>

    <!-- 搜索框样式 -->
    <style name="Widget.GameMatrix.Search" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeColor">?attr/colorOutline</item>
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="startIconTint">?attr/colorPrimary</item>
    </style>

    <!-- Tab样式 -->
    <style name="Widget.GameMatrix.Tab" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
        <item name="tabSelectedTextColor">?attr/colorPrimary</item>
        <item name="tabTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="tabTextAppearance">@style/TextAppearance.GameMatrix.Tab</item>
        <item name="tabRippleColor">?attr/colorPrimaryContainer</item>
    </style>

    <!-- Chip样式 -->
    <style name="Widget.GameMatrix.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">8dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="textStartPadding">12dp</item>
        <item name="textEndPadding">12dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.GameMatrix.Chip.Assist" parent="Widget.Material3.Chip.Assist">
        <item name="chipCornerRadius">6dp</item>
        <item name="chipMinHeight">24dp</item>
        <item name="textStartPadding">8dp</item>
        <item name="textEndPadding">8dp</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- 文本样式 -->
    <style name="TextAppearance.GameMatrix.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.GameMatrix.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.GameMatrix.Tab" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="TextAppearance.GameMatrix.CardTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.GameMatrix.CardDesc" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- 平台按钮兼容 -->
    <style name="Widget.GameMatrix.PlatformButton" parent="@android:style/Widget.Material.Button">
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:includeFontPadding">true</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
