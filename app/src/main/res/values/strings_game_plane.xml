    <!-- 游戏规则 -->
    <string name="game_plane_rules_title">飞机大战规则</string>
    <string name="game_plane_rules_content">
        1. 滑动手指控制飞机左右移动\n
        2. 飞机自动发射子弹\n
        3. 子弹击中敌机得分\n
        4. 被敌机碰到会失去一条命（共3条）\n
        5. 敌机飞出屏幕底部也会扣命\n
        6. 随着波次递增，敌机更多更快
    </string>

