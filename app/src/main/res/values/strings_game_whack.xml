    <!-- 游戏规则 -->
    <string name="game_whack_rules_title">打地鼠规则</string>
    <string name="game_whack_rules_content">
        1. 3×3网格中会随机冒出地鼠🐹\n
        2. 尽快点击地鼠得分！\n
        3. 点击空位会扣分\n
        4. 连续击中可获得额外加分\n
        5. 限时30秒，速度会越来越快\n
        6. 击中越多，得分越高
    </string>

