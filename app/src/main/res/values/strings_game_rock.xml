    <!-- 游戏规则 -->
    <string name="game_rock_rules_title">猜拳规则</string>
    <string name="game_rock_rules_content">
        1. 选择石头✊、剪刀✌️或布🖐\n
        2. 石头胜剪刀，剪刀胜布，布胜石头\n
        3. 双方出相同则平局\n
        4. 每赢一局得10分\n
        5. 挑战连胜记录！
    </string>

