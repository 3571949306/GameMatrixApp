    <!-- 游戏规则 -->
    <string name="game_match_rules_title">配对规则</string>
    <string name="game_match_rules_content">
        1. 翻开两张卡牌寻找相同的图案\n
        2. 图案相同则配对成功，卡牌消失\n
        3. 图案不同则翻回背面\n
        4. 消除所有配对即过关\n
        5. 随着关卡提升，卡牌数量递增\n
        6. 步数越少，得分越高
    </string>

