    <!-- 游戏规则 -->
    <string name="game_reaction_rules_title">反应力规则</string>
    <string name="game_reaction_rules_content">
        1. 屏幕显示一个红色方块\n
        2. 等待随机时间后方块变绿\n
        3. 绿色出现后尽快点击！\n
        4. 不要在变绿之前点击（会判定失败）\n
        5. 反应时间越短，得分越高\n
        6. 随着轮次增加，难度递增
    </string>

