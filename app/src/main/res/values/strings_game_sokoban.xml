    <!-- 游戏规则 -->
    <string name="game_sokoban_rules_title">推箱子规则</string>
    <string name="game_sokoban_rules_content">
        1. 使用方向按钮控制玩家上下左右移动\n
        2. 玩家推着箱子走，将箱子推到标记位置\n
        3. 箱子只能推不能拉\n
        4. 每次只能推一个箱子\n
        5. 所有箱子到达目标位置即通关\n
        6. 尽量用最少的步数完成挑战
    </string>

