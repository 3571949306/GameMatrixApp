<?xml version="1.0" encoding="utf-8"?>
<!-- 扫雷游戏字符串资源 -->
<resources>
    <!-- 游戏信息 -->
    <string name="minesweeper_rules_title">扫雷规则</string>
    <string name="minesweeper_rules_basic">在网格中翻开所有不含地雷的格子即可获胜。数字表示周围 8 格中地雷的数量。</string>
    <string name="minesweeper_rules_victory">翻开所有安全格子即为胜利。踩到地雷则游戏结束。</string>
    <string name="minesweeper_rules_scoring">通关得 100 分。不同难度对应不同棋盘大小和雷数。</string>
    <string name="minesweeper_rules_special">长按格子可以标记旗帜（标记疑似地雷的位置）。首次点击永远不会踩雷。</string>

    <!-- 成就 -->
    <string name="minesweeper_ach_first_win_name">扫雷新手</string>
    <string name="minesweeper_ach_first_win_desc">第一次通关扫雷</string>
    <string name="minesweeper_ach_win_10_name">扫雷达人</string>
    <string name="minesweeper_ach_win_10_desc">累计通关 10 次</string>
    <string name="minesweeper_ach_win_50_name">扫雷专家</string>
    <string name="minesweeper_ach_win_50_desc">累计通关 50 次</string>
    <string name="minesweeper_ach_speed_clear_name">闪电扫雷</string>
    <string name="minesweeper_ach_speed_clear_desc">60 秒内通关</string>
    <string name="minesweeper_ach_hard_win_name">困难征服者</string>
    <string name="minesweeper_ach_hard_win_desc">在困难难度下通关</string>
    <string name="minesweeper_ach_reveal_all_safe_name">全扫无遗</string>
    <string name="minesweeper_ach_reveal_all_safe_desc">翻开所有安全格子</string>

    <!-- 教程 -->
    <string name="minesweeper_tutorial_step1_title">翻开格子</string>
    <string name="minesweeper_tutorial_step1_desc">点击格子翻开它。数字表示周围 8 格中有几颗地雷。空白格表示周围没有地雷。</string>
    <string name="minesweeper_tutorial_step2_title">标记地雷</string>
    <string name="minesweeper_tutorial_step2_desc">长按格子可以标记旗帜，表示你认为这里有地雷。再次长按取消标记。</string>
    <string name="minesweeper_tutorial_step3_title">推理判断</string>
    <string name="minesweeper_tutorial_step3_desc">根据数字推理哪些格子是安全的，哪些有地雷。例如：数字 1 周围只有一个雷。</string>
    <string name="minesweeper_tutorial_step4_title">难度选择</string>
    <string name="minesweeper_tutorial_step4_desc">简单模式 9×9 格子 10 颗雷，普通 16×16 格子 40 颗雷，困难 16×30 格子 99 颗雷。</string>
</resources>
