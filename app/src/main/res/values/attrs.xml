<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ========== GameMatrixApp 自定义主题属性（A2: 设计 Token 系统） ========== -->
    <!-- 语义色 attr：供 layout 通过 ?attr/colorXxx 引用，明/暗由 themes.xml 与 themes-night.xml overlay -->
    <!-- 标准 M3 attr（colorPrimary/colorSurface/colorSurfaceContainerLow 等）无需在此声明 -->
    <attr name="colorSuccess" format="color" />
    <attr name="colorOnSuccess" format="color" />
    <attr name="colorSuccessContainer" format="color" />
    <attr name="colorOnSuccessContainer" format="color" />

    <attr name="colorWarning" format="color" />
    <attr name="colorOnWarning" format="color" />
    <attr name="colorWarningContainer" format="color" />
    <attr name="colorOnWarningContainer" format="color" />

    <attr name="colorInfo" format="color" />
    <attr name="colorOnInfo" format="color" />
    <attr name="colorInfoContainer" format="color" />
    <attr name="colorOnInfoContainer" format="color" />

    <!-- ===== 临时构建兼容垫片（不是浏览器模块的属性，勿当成浏览器资源） =====
         成因：layout/fragment_ai.xml 在 material 1.13 的 M3 Chip 上使用了
         app:closeIconContentDescription，该属性在当前 material 版本中已不存在，
         导致 :app:processDebugResources 失败，连带 compileDebugJavaWithJavac 全部跑不了。
         此处声明同名 attr 仅为让 aapt 能解析（值会被 Chip 忽略，无副作用）。
         待该布局改用 M3 支持的写法后，请删除本段。 -->
    <attr name="closeIconContentDescription" format="string|reference" />
</resources>
