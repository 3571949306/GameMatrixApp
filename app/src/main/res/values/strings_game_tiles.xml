    <!-- 游戏规则 -->
    <string name="game_tiles_rules_title">麻将连连看规则</string>
    <string name="game_tiles_rules_content">
        1. 在网格中找到两张相同的牌\n
        2. 依次点击两张相同的牌进行消除\n
        3. 消除所有配对即过关\n
        4. 随着关卡提升，牌面数量递增\n
        5. 步数越少，得分越高\n
        6. 挑战更高关卡！
    </string>

