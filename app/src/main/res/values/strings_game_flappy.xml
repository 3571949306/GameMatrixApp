    <!-- 游戏规则 -->
    <string name="game_flappy_rules_title">飞翔的小鸟规则</string>
    <string name="game_flappy_rules_content">
        1. 点击屏幕使小鸟上升\n
        2. 小鸟受重力影响会自然下落\n
        3. 穿过管道间隙得分\n
        4. 碰到管道或地面/天花板游戏结束\n
        5. 得分越高，难度越大\n
        6. 挑战你的最高记录！
    </string>

