    <!-- 游戏规则 -->
    <string name="game_memory_rules_title">记忆翻牌规则</string>
    <string name="game_memory_rules_content">
        1. 棋盘上有8对共16张卡牌\n
        2. 点击翻开一张卡牌，显示其图案\n
        3. 再翻开一张，如果图案相同则配对成功\n
        4. 图案不同则两张翻回背面\n
        5. 找出所有配对即为通关\n
        6. 尽量用最少的步数完成挑战
    </string>

