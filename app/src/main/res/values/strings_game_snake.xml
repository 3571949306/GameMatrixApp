    <!-- 教程 -->
    <string name="snake_tutorial_step1_title">滑动控制</string>
    <string name="snake_tutorial_step1_desc">在屏幕上滑动手指控制蛇的移动方向。上、下、左、右四个方向。</string>
    <string name="snake_tutorial_step2_title">吃食物</string>
    <string name="snake_tutorial_step2_desc">控制蛇吃到红色食物，每吃一个食物蛇身变长，得分增加 10 分。</string>
    <string name="snake_tutorial_step3_title">避免碰撞</string>
    <string name="snake_tutorial_step3_desc">不要撞到边界或蛇的身体，否则游戏结束。蛇越长越需要小心。</string>
    <string name="snake_tutorial_step4_title">挑战高分</string>
    <string name="snake_tutorial_step4_desc">尝试在不同难度下获得高分！难度越高，蛇移动速度越快。</string>

