    <!-- 教程 -->
    <string name="chinesechess_tutorial_step1_title">认识棋子</string>
    <string name="chinesechess_tutorial_step1_desc">红方有帅、仕、相、马、车、炮、兵；黑方有将、士、象、马、车、炮、卒。点击棋子选中。</string>
    <string name="chinesechess_tutorial_step2_title">走棋方法</string>
    <string name="chinesechess_tutorial_step2_desc">选中棋子后，点击目标位置移动。不同棋子走法不同，如马走日、象走田。</string>
    <string name="chinesechess_tutorial_step3_title">吃子规则</string>
    <string name="chinesechess_tutorial_step3_desc">移动到对方棋子的位置即可吃掉该棋子。注意炮需要隔一个棋子才能吃子。</string>
    <string name="chinesechess_tutorial_step4_title">将死获胜</string>
    <string name="chinesechess_tutorial_step4_desc">目标是将死对方的将/帅。保护好自己的将帅，同时攻击对方的将帅。</string>

