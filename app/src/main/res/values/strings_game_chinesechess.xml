    <!-- 游戏信息 -->
    <string name="chinesechess_rules_title">中国象棋规则</string>
    <string name="chinesechess_rules_basic">双方各执红黑棋子，在 9×10 的棋盘上轮流走棋。红方先行，目标是将死对方的将/帅。</string>
    <string name="chinesechess_rules_victory">将死对方将/帅即为胜利。将死指对方的将/帅无法逃脱被吃的命运。</string>
    <string name="chinesechess_rules_scoring">每局胜利得 100 分。不同难度的 AI 对手强度不同。</string>
    <string name="chinesechess_rules_special">七种棋子走法各异：将帅走九宫一格、仕士斜走、相象走田、马走日、车走直线、炮隔子吃、兵卒前进。</string>

