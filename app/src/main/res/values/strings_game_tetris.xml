<resources>
    <!-- 游戏信息 -->
    <string name="tetris_rules_title">俄罗斯方块规则</string>
    <string name="tetris_rules_basic">7 种不同形状的方块从顶部不断下落，你可以左右移动、旋转、Hold 暂存或硬降速落。</string>
    <string name="tetris_rules_victory">当一整行被方块填满时，该行会被消除并得分。4 行同消称 Tetris，可获 1.5× Back-to-Back 奖励。</string>
    <string name="tetris_rules_scoring">基础分：单行 100、双行 300、三行 500、Tetris 800（乘以等级）。</string>
    <string name="tetris_rules_special">每 10 行升一级，等级越高方块下落越快。</string>
    <string name="tetris_rules_modern">现代规则：T-Spin / Combo / Perfect Clear / Hold 暂存槽 — 全部支持。SRS 旋转 + 落点预览。</string>

