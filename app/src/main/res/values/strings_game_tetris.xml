    <!-- 教程 -->
    <string name="tetris_tutorial_step1_title">控制方块</string>
    <string name="tetris_tutorial_step1_desc">向左或向右滑动移动方块，向下滑动软降（Soft Drop），向下滑 Hard Drop 需要单击触发。</string>
    <string name="tetris_tutorial_step2_title">消除行列</string>
    <string name="tetris_tutorial_step2_desc">当一行被完全填满时，该行会被消除并得分。同时消除多行得分更高，4 行为 Tetris。</string>
    <string name="tetris_tutorial_step3_title">Hold &amp; Ghost</string>
    <string name="tetris_tutorial_step3_desc">Hold 暂存当前方块；虚线方块为落点预览。</string>
    <string name="tetris_tutorial_step4_title">T-Spin 进阶</string>
    <string name="tetris_tutorial_step4_desc">将 T 块旋转嵌入缝隙可获 T-Spin 奖励（最高 1600/级）。</string>
    <string name="tetris_tutorial_step5_title">游戏结束</string>
    <string name="tetris_tutorial_step5_desc">方块堆积到顶部时游戏结束，尽量保持堆叠整齐。</string>

