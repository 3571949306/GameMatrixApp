    <!-- 教程 -->
    <string name="tetris_tutorial_step1_title">控制方块</string>
    <string name="tetris_tutorial_step1_desc">向左或向右滑动移动方块，向下滑动加速下落，向上滑动或点击旋转方块。</string>
    <string name="tetris_tutorial_step2_title">消除行列</string>
    <string name="tetris_tutorial_step2_desc">当一行被完全填满时，该行会被消除并获得分数。同时消除多行得分更高。</string>
    <string name="tetris_tutorial_step3_title">等级提升</string>
    <string name="tetris_tutorial_step3_desc">每消除 10 行升一级，方块下落速度会加快。挑战更高等级！</string>
    <string name="tetris_tutorial_step4_title">游戏结束</string>
    <string name="tetris_tutorial_step4_desc">当方块堆积到顶部时游戏结束。尽量保持堆叠整齐，留出空间。</string>
