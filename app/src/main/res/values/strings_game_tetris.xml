<resources>
    <!-- 游戏信息 -->
    <string name="tetris_rules_title">俄罗斯方块规则</string>
    <string name="tetris_rules_basic">7 种不同形状的方块从顶部不断下落，你可以左右移动、旋转方块，并加速下落。</string>
    <string name="tetris_rules_victory">当一整行被方块填满时，该行会被消除。消除的行数越多，得分越高。</string>
    <string name="tetris_rules_scoring">消除 1 行得 100 分，2 行 300 分，3 行 500 分，4 行 800 分（乘以等级倍数）。</string>
    <string name="tetris_rules_special">每消除 10 行升一级，等级越高方块下落越快。同时消除 4 行称为"完美消除"。</string>

