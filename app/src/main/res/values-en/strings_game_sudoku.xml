    <!-- Sudoku rules -->
    <string name="game_sudoku_rules_title">Sudoku rules</string>
    <string name="game_sudoku_rules_content">
        1. Fill a 9×9 grid with numbers 1-9\n
        2. Each row must contain 1-9 without repeats\n
        3. Each column must contain 1-9 without repeats\n
        4. Each 3×3 box must contain 1-9 without repeats\n
        5. Select an empty cell, then choose a number below\n
        6. Use hints to reveal a correct answer
    </string>

