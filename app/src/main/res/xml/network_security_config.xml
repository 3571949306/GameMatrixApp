<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 模块分发服务器域名 — 启用证书绑定（pin-set）防止中间人攻击 -->
    <!-- 2026-08-29 域名迁移：hk-update.tcp0053.shop 已失效，更换为 hk-update.tcp888.uk（直连，端口 2083 由 server.url 携带） -->
    <!-- 证书指纹来自 Let's Encrypt 新证书链（Leaf/YE1/Root YE），与 SecureOkHttpFactory.MODULE_SERVER_PINS 保持一致 -->
    <domain-config>
        <domain includeSubdomains="true">hk-update.tcp888.uk</domain>
        <pin-set>
            <pin digest="SHA-256">ijBcxbC/7DLkqL9aYpHjoLtOOzkcA7YIE/RbNCLJYRg=</pin>
            <pin digest="SHA-256">brzvtCELCIZUo4sD/qPX0ccRtPsd3DY6RfmxpOU9oB4=</pin>
            <pin digest="SHA-256">sCkq5UWXjg+7mKu9lMhhYF5bGLsy7VI/UNW3tccdR7w=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- AI API 域名 — 强制 HTTPS，禁止明文流量 -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.openai.com</domain>
        <domain includeSubdomains="true">api.deepseek.com</domain>
        <domain includeSubdomains="true">dashscope.aliyuncs.com</domain>
        <domain includeSubdomains="true">api.siliconflow.cn</domain>
        <domain includeSubdomains="true">open.bigmodel.cn</domain>
        <domain includeSubdomains="true">api.lingyiwanwu.com</domain>
        <domain includeSubdomains="true">api.moonshot.cn</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- 下载加速服务器备用域名 (CDN fallback) - 仅在配置时生效 -->
    <!-- 通过 buildConfigField 注入 DOWNLOAD_FALLBACK_BASE_URL 时启用 -->
    <!-- <domain-config>
        <domain includeSubdomains="true">fallback-cdn.example.com</domain>
        <pin-set>
            <pin digest="SHA-256">FALLBACK_PIN_1</pin>
            <pin digest="SHA-256">FALLBACK_PIN_2</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config> -->

    <!-- 局域网明文流量 — 仅限本地网络使用，切勿用于公网通信 -->
    <!-- 注意：Android network security config 不支持 CIDR 表示法，需用字面量 IP -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
