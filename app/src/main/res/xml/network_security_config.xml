<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 模块服务器域名 — 启用证书固定（pin-set）防止中间人攻击 -->
    <!-- 部署时替换为实际服务器域名，或从 local.properties 生成 -->
    <!-- 在 build.gradle 中通过 buildConfigField 注入实际域名后，取消注释以下配置 -->
    <!-- <domain-config>
        <domain includeSubdomains="true">YOUR_ACTUAL_SERVER_DOMAIN</domain>
        <pin-set>
            <pin digest="SHA-256">YOUR_ACTUAL_PIN_HASH</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config> -->

    <!-- AI API 域名 — 强制 HTTPS，禁止明文流量 -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.openai.com</domain>
        <domain includeSubdomains="true">api.deepseek.com</domain>
        <domain includeSubdomains="true">dashscope.aliyuncs.com</domain>
        <domain includeSubdomains="true">api.siliconflow.cn</domain>
        <domain includeSubdomains="true">open.bigmodel.cn</domain>
        <domain includeSubdomains="true">api.lingyiwanwu.com</domain>
        <domain includeSubdomains="true">api.moonshot.cn</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- 局域网明文流量 — 仅限本地网络使用，切勿用于公网通信 -->
    <!-- 注意：Android network security config 不支持 CIDR 表示法，需用字面量 IP -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
