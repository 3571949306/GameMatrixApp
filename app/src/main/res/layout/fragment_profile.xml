<?xml version="1.0" encoding="utf-8"?>
<!-- 个人中心 Fragment：头像区 + 战绩卡片 + 收藏卡片 + 快捷入口 -->
<!-- BUG-002 复测修复13（最终方案4）：fillViewport=false + card_quick_entries 固定 168dp。
     修复11/12 失败原因：fillViewport=true 时 NestedScrollView 强制 LinearLayout 高度 = 视口高度，
     导致 LinearLayout 内部所有 wrap_content/fixed 子 View 被压缩到视口内。
     当前方案：fillViewport=false 让子 LinearLayout 按 wrap_content 自然测量，
     同时 card_quick_entries 固定 168dp 防止 LinearLayout 的 wrap_content 重新测量机制压缩最后一个子 View。
     如果内容超出视口，可滚动查看（profile_header 等不必看全）。 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?android:attr/colorBackground">

        <!-- ===== 顶部头像区 ===== -->
        <LinearLayout
            android:id="@+id/profile_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="@dimen/gm_spacing_3"
            android:paddingBottom="@dimen/gm_spacing_3"
            android:paddingStart="@dimen/gm_spacing_4"
            android:paddingEnd="@dimen/gm_spacing_4"
            android:background="@drawable/bg_top_bar_gradient">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_avatar_circle">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_avatar_placeholder"
                    android:contentDescription="@string/profile_guest_name"
                    app:tint="@color/top_bar_on_gradient" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gm_spacing_3"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/top_bar_on_gradient"
                tools:text="@string/profile_guest_name" />

            <TextView
                android:id="@+id/tv_profile_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="@color/top_bar_on_gradient_variant"
                android:text="@string/profile_subtitle" />
        </LinearLayout>

        <!-- ===== 战绩卡片 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_stats"
            style="@style/Widget.GameMatrix.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gm_spacing_2"
            android:layout_marginStart="@dimen/gm_spacing_4"
            android:layout_marginEnd="@dimen/gm_spacing_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/gm_spacing_4">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_section_stats"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gm_spacing_3"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <!-- 当前连胜 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_profile_streak_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            tools:text="3" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/streak_current_days"
                            android:textSize="11sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <!-- 最佳连胜 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_profile_best_streak_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            tools:text="7" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/streak_best_days"
                            android:textSize="11sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <!-- 总对局 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_profile_total_games_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            tools:text="42" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/streak_total_games"
                            android:textSize="11sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 收藏数卡片 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_favorites"
            style="@style/Widget.GameMatrix.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gm_spacing_1"
            android:layout_marginStart="@dimen/gm_spacing_4"
            android:layout_marginEnd="@dimen/gm_spacing_4"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/gm_spacing_4">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_favorite_filled"
                    android:contentDescription="@string/profile_my_favorites"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/gm_spacing_3"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_my_favorites"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/tv_profile_favorites_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="5 款游戏" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@string/profile_my_favorites"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 快捷入口卡片（2x2 网格） ===== -->
        <!-- BUG-002 复测修复12（最终方案3）：使用固定高度 168dp 而非 wrap_content。
             根因：LinearLayout 在 EXACTLY 模式（fillViewport=true 时父容器强制高度）
             下会把 wrap_content 的最后一个子 View 重新测量为 AT_MOST，
             导致 card_quick_entries 被压缩，第二行按钮高度从 72dp 被压缩到 32dp。
             固定 168dp = padding(8dp*2) + 第一行按钮(72dp) + 行间距(8dp) + 第二行按钮(72dp)
             可以避免 LinearLayout 的 wrap_content 重新测量机制。 -->
        <LinearLayout
            android:id="@+id/card_quick_entries"
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/gm_spacing_1"
            android:layout_marginStart="@dimen/gm_spacing_4"
            android:layout_marginEnd="@dimen/gm_spacing_4"
            android:layout_marginBottom="@dimen/gm_spacing_1"
            android:padding="@dimen/gm_spacing_2"
            android:background="?attr/colorSurface"
            android:elevation="2dp">

            <!-- 第一行：游戏统计 / 成就中心 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:id="@+id/btn_profile_stats"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_stats_playtime"
                        android:contentDescription="@string/profile_my_stats"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/profile_my_stats"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_profile_achievements"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_star_filled"
                        android:contentDescription="@string/profile_my_achievements"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/profile_my_achievements"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>
            </LinearLayout>

            <!-- 第二行：模块商店 / 资料设置 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/gm_spacing_2"
                android:weightSum="2">

                <LinearLayout
                    android:id="@+id/btn_profile_module_store"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_tools"
                        android:contentDescription="@string/profile_module_store"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/profile_module_store"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_profile_settings"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_settings"
                        android:contentDescription="@string/profile_settings"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/profile_settings"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
