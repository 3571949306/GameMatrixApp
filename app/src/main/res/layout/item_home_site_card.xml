<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/gm_spacing_2"
    android:layout_marginEnd="@dimen/gm_spacing_2"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/gm_spacing_3">

    <ImageView
        android:id="@+id/site_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/browser_home_site_icon" />

    <TextView
        android:id="@+id/site_title"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gm_spacing_2"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp" />
</LinearLayout>
