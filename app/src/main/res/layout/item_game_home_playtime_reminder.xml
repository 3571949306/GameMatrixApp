<?xml version="1.0" encoding="utf-8"?>
<!-- 今日时长提醒卡（批次 2b，对齐 legacy Batch 11-3 卡片视觉）：MILD/SEVERE 渐变由代码按档位切换 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_game_home_playtime_reminder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_playtime_reminder_gradient_mild"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- 左侧休息图标 -->
    <ImageView
        android:id="@+id/iv_playtime_reminder_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@string/playtime_reminder_title"
        android:scaleType="centerInside"
        android:src="@drawable/ic_playtime_reminder_coffee"
        app:tint="@android:color/white" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_playtime_reminder_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/playtime_reminder_title"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_playtime_reminder_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_playtime_reminder_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.95"
            android:textColor="@android:color/white"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 右侧"知道了"（会话级 dismiss） -->
    <TextView
        android:id="@+id/btn_playtime_reminder_dismiss"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_playtime_reminder_btn"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="@string/playtime_reminder_action_dismiss"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
