<?xml version="1.0" encoding="utf-8"?>
<!-- Feature F (GAME_STATS_DASHBOARD): 游戏统计仪表盘布局 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- ===== 顶栏 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_48"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_8"
        android:paddingEnd="@dimen/spacing_16"
        android:background="?attr/colorSurface">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="@dimen/icon_size_large"
            android:layout_height="@dimen/icon_size_large"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/stats_back"
            android:padding="@dimen/spacing_8"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_8"
            android:text="@string/stats_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== 内容滚动区 ===== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16">

            <!-- ===== Hero 卡片：4 个核心指标 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_20"
                android:background="@drawable/bg_stats_hero">

                <!-- 标题 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_hero_title"
                    android:textColor="@color/top_bar_on_gradient"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/stats_hero_subtitle"
                    android:textColor="@color/top_bar_on_gradient_variant"
                    android:textSize="11sp" />

                <!-- 4 列指标网格 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:orientation="horizontal"
                    android:weightSum="4">

                    <!-- 总时长 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="@dimen/icon_size_medium"
                            android:layout_height="@dimen/icon_size_medium"
                            android:background="@drawable/bg_stats_icon_circle"
                            android:padding="@dimen/gm_spacing_1"
                            android:scaleType="centerInside"
                            app:srcCompat="@drawable/ic_stats_playtime"
                            app:tint="@color/top_bar_on_gradient" />

                        <TextView
                            android:id="@+id/tv_stat_playtime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_6"
                            android:textColor="@color/top_bar_on_gradient"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="0m" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/stats_total_playtime"
                            android:textColor="@color/top_bar_on_gradient_variant"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- 活跃天数 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="@dimen/icon_size_medium"
                            android:layout_height="@dimen/icon_size_medium"
                            android:background="@drawable/bg_stats_icon_circle"
                            android:padding="@dimen/gm_spacing_1"
                            android:scaleType="centerInside"
                            app:srcCompat="@drawable/ic_stats_days"
                            app:tint="@color/top_bar_on_gradient" />

                        <TextView
                            android:id="@+id/tv_stat_active_days"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_6"
                            android:textColor="@color/top_bar_on_gradient"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/stats_active_days"
                            android:textColor="@color/top_bar_on_gradient_variant"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- 总对局 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="@dimen/icon_size_medium"
                            android:layout_height="@dimen/icon_size_medium"
                            android:background="@drawable/bg_stats_icon_circle"
                            android:padding="@dimen/gm_spacing_1"
                            android:scaleType="centerInside"
                            app:srcCompat="@drawable/ic_stats_launches"
                            app:tint="@color/top_bar_on_gradient" />

                        <TextView
                            android:id="@+id/tv_stat_total_games"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_6"
                            android:textColor="@color/top_bar_on_gradient"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/stats_total_games"
                            android:textColor="@color/top_bar_on_gradient_variant"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- 当前连胜 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="@dimen/icon_size_medium"
                            android:layout_height="@dimen/icon_size_medium"
                            android:background="@drawable/bg_stats_icon_circle"
                            android:padding="@dimen/gm_spacing_1"
                            android:scaleType="centerInside"
                            app:srcCompat="@drawable/ic_stats_streak"
                            app:tint="@color/top_bar_on_gradient" />

                        <TextView
                            android:id="@+id/tv_stat_streak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_6"
                            android:textColor="@color/top_bar_on_gradient"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/stats_current_streak"
                            android:textColor="@color/top_bar_on_gradient_variant"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 最佳连胜 footer -->
                <TextView
                    android:id="@+id/tv_best_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:textColor="@color/top_bar_on_gradient_variant"
                    android:textSize="11sp"
                    tools:text="最佳连胜：0 天" />
            </LinearLayout>

            <!-- ===== Top 5 最常玩 ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GameMatrix.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_top_games"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/top_games_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tv_no_top_games"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:gravity="center"
                        android:text="@string/stats_no_top_games"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== 成就概览（点击跳转成就中心） ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_achievement_summary"
                style="@style/Widget.GameMatrix.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/spacing_16">

                    <ImageView
                        android:layout_width="@dimen/icon_size_large"
                        android:layout_height="@dimen/icon_size_large"
                        android:padding="@dimen/spacing_6"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ic_star_filled"
                        app:tint="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_12"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stats_achievement_summary"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_achievement_progress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp"
                            tools:text="已解锁 0 / 0" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ic_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- P2-8 (STATS_VISUALIZATION): 近 7 天游玩时长趋势 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GameMatrix.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_chart_trend_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/stats_chart_trend_subtitle"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp" />

                    <com.gamecenter.app.games.StatsChartView
                        android:id="@+id/chart_trend"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="@dimen/spacing_12" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- P2-8: 胜负分布饼图 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GameMatrix.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_chart_pie_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.gamecenter.app.games.StatsChartView
                        android:id="@+id/chart_win_loss"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="@dimen/spacing_8" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- P2-8: Top 5 游戏时长柱状图 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GameMatrix.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_chart_bar_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.gamecenter.app.games.StatsChartView
                        android:id="@+id/chart_top_games"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="@dimen/spacing_8" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== 胜负统计 ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GameMatrix.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:layout_marginBottom="@dimen/spacing_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_win_loss_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <!-- 胜场 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_win_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/colorSuccess"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                tools:text="0" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/stats_win_count"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- 负场 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_loss_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/md_theme_error"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                tools:text="0" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/stats_loss_count"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
