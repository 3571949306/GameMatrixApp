<?xml version="1.0" encoding="utf-8"?>
<!-- Batch 12-1 (HOME_RESUME_GAME_CARD): 首页"继续游玩"卡片。
     显示最近一次游玩的游戏图标、名称、上次游玩时间、继续按钮。
     点击卡片或继续按钮直接启动游戏。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_16"
    android:layout_marginEnd="@dimen/spacing_16"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="@dimen/spacing_16"
    android:background="@drawable/bg_resume_game_gradient"
    android:elevation="2dp">

    <!-- 左侧游戏图标 -->
    <ImageView
        android:id="@+id/iv_resume_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/home_resume_game_title"
        android:scaleType="centerInside"
        tools:src="@drawable/ic_gomoku" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/spacing_12"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_resume_game_title"
            android:textColor="@android:color/white"
            android:alpha="0.85"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_resume_game_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="五子棋" />

        <TextView
            android:id="@+id/tv_resume_game_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@android:color/white"
            android:alpha="0.9"
            android:textSize="11sp"
            tools:text="3 小时前" />
    </LinearLayout>

    <!-- 右侧"继续"按钮 -->
    <TextView
        android:id="@+id/btn_resume_play"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_16"
        android:paddingTop="@dimen/spacing_8"
        android:paddingBottom="@dimen/spacing_8"
        android:background="@drawable/bg_resume_game_btn"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/home_resume_game_action"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
