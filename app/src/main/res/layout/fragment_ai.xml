<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- A quiet title bar keeps the conversation, rather than controls, primary. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/gm_spacing_4"
        android:paddingEnd="@dimen/gm_spacing_2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_assistant_label"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/ai_chat_subtitle"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_ai_history"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ai_chat_history"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_recent_history"
            app:tint="?android:attr/textColorSecondary" />

        <ImageButton
            android:id="@+id/btn_ai_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ai_chat_more"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_more"
            app:tint="?android:attr/textColorSecondary" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/layout_ai_conversation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_ai_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/gm_spacing_2"
            android:paddingTop="@dimen/gm_spacing_2"
            android:paddingEnd="@dimen/gm_spacing_2"
            android:paddingBottom="@dimen/gm_spacing_2"
            tools:listitem="@layout/item_ai_message_assistant" />

        <!-- Empty state sits behind the list and is toggled by the Fragment. -->
        <LinearLayout
            android:id="@+id/layout_ai_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/gm_spacing_4"
            android:paddingEnd="@dimen/gm_spacing_4">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_chat_empty_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gm_spacing_2"
                android:gravity="center"
                android:maxWidth="320dp"
                android:text="@string/ai_chat_empty_body"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gm_spacing_4"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_ai_templates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_ai"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/gm_spacing_3"
            android:visibility="gone" />
    </FrameLayout>

    <!-- A selected one-shot task is secondary context, not a permanent form control. -->
    <com.google.android.material.chip.Chip
        android:id="@+id/chip_ai_task_context"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gm_spacing_3"
        android:layout_marginBottom="@dimen/gm_spacing_1"
        android:checkable="false"
        android:visibility="gone"
        app:closeIconContentDescription="@string/ai_chat_task_chat"
        app:closeIconVisible="true"
        style="@style/Widget.Material3.Chip.Filter" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_ai_composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gm_spacing_3"
        android:layout_marginEnd="@dimen/gm_spacing_3"
        android:layout_marginBottom="@dimen/gm_spacing_3"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
        app:cardCornerRadius="@dimen/ai_chat_composer_radius"
        app:cardElevation="1dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gm_spacing_3"
            android:paddingTop="@dimen/gm_spacing_2"
            android:paddingEnd="@dimen/gm_spacing_3"
            android:paddingBottom="@dimen/gm_spacing_1">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ai_chat_input_hint"
                app:boxBackgroundMode="none"
                app:endIconMode="clear_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_ai_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="6"
                    android:minLines="1"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ai_add"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/ai_chat_add"
                    android:text="+"
                    android:textSize="22sp"
                    app:iconPadding="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ai_model"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:contentDescription="@string/ai_chat_model"
                    android:ellipsize="end"
                    android:maxWidth="180dp"
                    android:maxLines="1"
                    android:text="@string/ai_chat_local_mode_short"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_ai_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/ai_chat_status_ready"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ai_send"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/ai_chat_send"
                    android:text="➤"
                    android:textSize="20sp"
                    app:iconPadding="0dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_ai_privacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:text="@string/ai_chat_privacy_local"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
