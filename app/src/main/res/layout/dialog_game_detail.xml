<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:paddingTop="@dimen/spacing_8"
    android:paddingBottom="@dimen/spacing_24"
    android:paddingStart="@dimen/spacing_20"
    android:paddingEnd="@dimen/spacing_20">

    <!-- 拖动指示器 -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/spacing_16"
        android:background="@drawable/bg_bottom_sheet_drag_handle"
        android:importantForAccessibility="no" />

    <!-- 顶部：图标 + 标题 + 收藏按钮行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_detail_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_game_icon_gradient_default"
            android:contentDescription="@string/visual_refresh_game_icon"
            android:padding="12dp"
            android:scaleType="centerInside"
            tools:src="@drawable/ic_game" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_detail_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GameMatrix.CardTitle"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="五子棋" />

            <TextView
                android:id="@+id/tv_detail_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="@dimen/spacing_12"
                android:paddingEnd="@dimen/spacing_12"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_category_tag_classics"
                tools:text="经典" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_detail_favorite"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/game_detail_favorite_add"
            android:padding="8dp"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_favorite"
            app:tint="?attr/colorPrimary" />
    </LinearLayout>

    <!-- 描述 -->
    <TextView
        android:id="@+id/tv_detail_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:lineSpacingExtra="3dp"
        android:textAppearance="@style/TextAppearance.GameMatrix.CardDesc"
        android:textSize="14sp"
        tools:text="经典五子棋人机对战，支持先手选择、计时与音效。" />

    <!-- 战绩标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        android:text="@string/game_detail_stats_label"
        android:textColor="?attr/colorPrimary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:textAllCaps="true" />

    <!-- 战绩卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0.5dp"
        app:strokeColor="?attr/colorOutline"
        app:cardBackgroundColor="?attr/colorSurfaceVariant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16">

            <TextView
                android:id="@+id/tv_detail_play_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GameMatrix.CardDesc"
                android:textSize="13sp"
                tools:text="总对局：12 次" />

            <TextView
                android:id="@+id/tv_detail_win_loss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.GameMatrix.CardDesc"
                android:textSize="13sp"
                tools:text="胜 5 / 负 3" />

            <TextView
                android:id="@+id/tv_detail_play_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.GameMatrix.CardDesc"
                android:textSize="13sp"
                tools:text="总时长：23 分钟" />

            <TextView
                android:id="@+id/tv_detail_high_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.GameMatrix.CardDesc"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="最高分：2048"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tv_detail_last_played"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.GameMatrix.CardDesc"
                android:textSize="13sp"
                tools:text="上次游玩：3 天前" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 立即开始按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_detail_play"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_24"
        android:paddingTop="@dimen/spacing_12"
        android:paddingBottom="@dimen/spacing_12"
        android:text="@string/game_detail_play_now"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_play_arrow"
        app:iconGravity="textStart" />

    <!-- P0-1 (LEADERBOARD): 查看排行榜按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_detail_leaderboard"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:paddingTop="@dimen/spacing_8"
        android:paddingBottom="@dimen/spacing_8"
        android:text="@string/leaderboard_title"
        android:textSize="14sp"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_leaderboard"
        app:iconGravity="textStart" />

    <!-- P0-3 (SHARE_CARD): 分享战绩按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_detail_share"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:paddingTop="@dimen/spacing_8"
        android:paddingBottom="@dimen/spacing_8"
        android:text="@string/share_card_action"
        android:textSize="14sp"
        app:cornerRadius="14dp"
        app:icon="@android:drawable/ic_menu_share"
        app:iconGravity="textStart" />

    <!-- Batch 11-1 (GAME_RATING_SYSTEM): 用户评分区块（默认隐藏） -->
    <LinearLayout
        android:id="@+id/section_user_rating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/game_rating_button_text"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textAllCaps="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/stars_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/star_1"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/game_rating_star_desc"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_star_border"
                    app:tint="@color/rating_star" />

                <ImageView
                    android:id="@+id/star_2"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/game_rating_star_desc"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_star_border"
                    app:tint="@color/rating_star" />

                <ImageView
                    android:id="@+id/star_3"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/game_rating_star_desc"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_star_border"
                    app:tint="@color/rating_star" />

                <ImageView
                    android:id="@+id/star_4"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/game_rating_star_desc"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_star_border"
                    app:tint="@color/rating_star" />

                <ImageView
                    android:id="@+id/star_5"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/game_rating_star_desc"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_star_border"
                    app:tint="@color/rating_star" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_clear_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_8"
                android:paddingStart="@dimen/spacing_8"
                android:paddingEnd="@dimen/spacing_8"
                android:paddingTop="@dimen/spacing_6"
                android:paddingBottom="@dimen/spacing_6"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/game_rating_clear"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_rating_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            tools:text="我的评分：4★" />
    </LinearLayout>

</LinearLayout>
