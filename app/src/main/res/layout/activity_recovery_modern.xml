<?xml version="1.0" encoding="utf-8"?>
<!-- 现代恢复模式界面（美化版） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/gm_spacing_6">

        <!-- 头部徽标 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="@dimen/gm_spacing_6"
            app:cardBackgroundColor="@color/brand_primary"
            app:cardCornerRadius="48dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:contentDescription="@string/recovery_icon_desc"
                android:src="@drawable/ic_recovery_shield"
                app:tint="@color/white" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gm_spacing_5"
            android:gravity="center"
            android:text="@string/recovery_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- 状态说明 -->
        <TextView
            android:id="@+id/tv_recovery_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/recovery_status_ready"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

        <!-- 实时信息面板 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gm_spacing_6"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:contentPadding="16dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_recovery"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="0"
                    app:indicatorColor="@color/brand_primary"
                    app:trackColor="?attr/colorOutlineVariant"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp" />

                <TextView
                    android:id="@+id/tv_recovery_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_recovery_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="middle"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 错误提示卡片（默认隐藏，由 Activity 控制显隐） -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_recovery_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gm_spacing_4"
            android:visibility="gone"
            app:cardBackgroundColor="@color/md_theme_error_container"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:contentPadding="14dp"
            app:strokeColor="@color/md_theme_error"
            app:strokeWidth="0.5dp">

            <TextView
                android:id="@+id/tv_recovery_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/md_theme_on_error_container"
                android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 下载按钮（主操作） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_recovery_download"
            style="@style/Widget.GameMatrix.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="@string/recovery_btn_download"
            android:textSize="16sp"
            app:icon="@android:drawable/stat_sys_download"
            app:iconSize="20dp" />

        <!-- 安装按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_recovery_install"
            style="@style/Widget.GameMatrix.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:enabled="false"
            android:text="@string/recovery_btn_install"
            android:textSize="16sp"
            app:icon="@android:drawable/ic_menu_save"
            app:iconSize="20dp" />

        <!-- 重试按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_recovery_retry"
            style="@style/Widget.GameMatrix.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:text="@string/recovery_btn_retry"
            android:textSize="16sp" />

        <!-- 取消按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_recovery_cancel"
            style="@style/Widget.GameMatrix.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            android:text="@string/recovery_btn_cancel"
            android:textSize="14sp" />

        <!-- 逃生出口：离线/无网且无法安装时，允许用户跳过恢复直接启动主程序 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_recovery_launch_anyway"
            style="@style/Widget.GameMatrix.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="2dp"
            android:text="@string/recovery_btn_launch_anyway"
            android:textSize="14sp" />

        <!-- 底部提示 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gm_spacing_6"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/recovery_hint"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
