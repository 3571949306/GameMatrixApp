<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-07-25: 密码生成器工具布局 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gm_spacing_3"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tool_password_length"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_password_length"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="number"
            android:text="16" />
    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cg_password_charset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gm_spacing_2">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_password_upper"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/tool_password_upper" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_password_lower"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/tool_password_lower" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_password_digits"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/tool_password_digits" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_password_symbols"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tool_password_symbols" />
    </com.google.android.material.chip.ChipGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gm_spacing_2"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_password_generate"
            style="@style/Widget.GameMatrix.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/tool_password_generate" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_password_copy"
            style="@style/Widget.GameMatrix.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/gm_spacing_2"
            android:layout_weight="1"
            android:text="@string/tool_password_copy" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_password_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gm_spacing_2"
        android:background="?attr/colorSurfaceVariant"
        android:fontFamily="monospace"
        android:padding="@dimen/gm_spacing_3"
        android:textColor="?android:attr/textColorPrimary"
        android:textIsSelectable="true"
        android:textSize="14sp" />
</LinearLayout>
