<?xml version="1.0" encoding="utf-8"?>
<!--
    斗地主菜单界面布局 (activity_doudizhu_menu.xml)
    竖屏显示，提供单机模式和联机模式选择
    美化版本：深绿色渐变背景 + 金色主题
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_doudizhu_menu"
    android:padding="32dp">

    <!-- 游戏标题 -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="斗地主"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#FFD700"
        android:shadowColor="#B8860B"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:layout_marginBottom="80dp" />

    <!-- 难度选择标题 -->
    <TextView
        android:id="@+id/tvDifficultyLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/difficulty"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFD700"
        android:layout_marginBottom="12dp" />

    <!-- 难度选择按钮组（横向） -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="32dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDiffEasy"
            android:layout_width="90dp"
            android:layout_height="48dp"
            android:text="@string/doudizhu_diff_easy"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_gold_gradient"
            android:foreground="@drawable/ripple_gold"
            android:elevation="6dp"
            android:layout_marginEnd="12dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDiffNormal"
            android:layout_width="90dp"
            android:layout_height="48dp"
            android:text="@string/doudizhu_diff_normal"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_gold_gradient"
            android:foreground="@drawable/ripple_gold"
            android:elevation="6dp"
            android:layout_marginEnd="12dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDiffHard"
            android:layout_width="90dp"
            android:layout_height="48dp"
            android:text="@string/doudizhu_diff_hard"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_gold_gradient"
            android:foreground="@drawable/ripple_gold"
            android:elevation="6dp" />
    </LinearLayout>

    <!-- 单机模式按钮 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSinglePlayer"
        android:layout_width="280dp"
        android:layout_height="64dp"
        android:text="单机模式"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="@drawable/btn_gold_gradient"
        android:foreground="@drawable/ripple_gold"
        android:elevation="8dp"
        android:layout_marginBottom="32dp" />

    <!-- 联机模式按钮 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnOnline"
        android:layout_width="280dp"
        android:layout_height="64dp"
        android:text="局域网联机"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="@drawable/btn_gold_gradient"
        android:foreground="@drawable/ripple_gold"
        android:elevation="8dp"
        android:layout_marginBottom="32dp" />

    <!-- 远程P2P按钮 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnRemoteP2P"
        android:layout_width="280dp"
        android:layout_height="64dp"
        android:text="云联机"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="@drawable/btn_gold_gradient"
        android:foreground="@drawable/ripple_gold"
        android:elevation="8dp"
        android:layout_marginBottom="64dp" />

    <!-- 返回按钮 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnBack"
        android:layout_width="160dp"
        android:layout_height="48dp"
        android:text="返回"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="@drawable/btn_gold_gradient"
        android:foreground="@drawable/ripple_gold"
        android:elevation="6dp"
        android:layout_marginBottom="32dp" />

    <!-- 底部装饰线 -->
    <View
        android:layout_width="200dp"
        android:layout_height="2dp"
        android:background="#FFD700"
        android:alpha="0.6" />

</LinearLayout>
