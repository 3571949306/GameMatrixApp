<?xml version="1.0" encoding="utf-8"?>
<!-- 模块商店主页（Batch 20/21: Hero Banner 轮播 + 三栏统计卡片+趋势 + 分类 tab 图标 + 详情入口） -->
<!-- P2.4: 根容器 id=moduleStoreRootContainer 供 StoreSectionRendererRegistry.dispatchRender 使用 -->
<!-- MODULE_STORE_PERF_OPT: 移除 NestedScrollView 包裹，让 RecyclerView 正常回收复用，避免一次性测量所有 item -->
<!-- P1 修复：根容器由 LinearLayout 改为 ConstraintLayout，将内容区 moduleListContainer 用
     top/bottom 约束钉在「子分类栏」与「父容器底部」之间（height=0dp），确保 RecyclerView
     始终获得确定的剩余高度，消除 LinearLayout weight 在可见性切换后偶发测量为 0 的问题。 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/moduleStoreRootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/moduleToolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        android:elevation="@dimen/gm_elevation_1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:title="@string/module_store_title"
        app:titleTextColor="?android:attr/textColorPrimary"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="?attr/colorOnSurface"
        app:menu="@menu/module_store_menu" />

    <!-- ===== 2026-08-30 布局重规划：头部由 5 层压缩为 2 行 =====
         旧行序 Hero轮播(120dp) + 三张统计大卡(~76dp) + 一键更新按钮 + 统计文本 + 搜索框 + 主分类 + 子分类
         在常规手机上占掉 ~300dp，列表可视区仅剩一小条，滚动体验差。
         新行序：统计摘要单行(含内联一键更新) → 瘦身搜索框 → 主分类 tab → 子分类(条件显示)。
         Hero 轮播保留但仅由远程 Banner 配置驱动，默认 GONE 不占位。
         所有 view id 保持不变，Activity 零改动兼容。 -->

    <!-- Hero Banner 精选推荐轮播（P1.3: 仅远程 catalog.heroBanners 配置时显示） -->
    <FrameLayout
        android:id="@+id/heroBannerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gm_spacing_3"
        android:layout_marginEnd="@dimen/gm_spacing_3"
        android:layout_marginTop="@dimen/gm_spacing_2"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/moduleToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/heroViewPager"
            android:layout_width="match_parent"
            android:layout_height="120dp" />

        <!-- 页面指示器 -->
        <LinearLayout
            android:id="@+id/heroIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/gm_spacing_2"
            android:orientation="horizontal"
            android:gravity="center" />
    </FrameLayout>

    <!-- 统计摘要单行：N 全部 · N 已装 · N 可更新（趋势子文本内联），一键更新按钮内联右侧 -->
    <LinearLayout
        android:id="@+id/statsBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:paddingStart="@dimen/gm_spacing_3"
        android:paddingEnd="@dimen/gm_spacing_2"
        android:paddingTop="@dimen/gm_spacing_2"
        android:paddingBottom="@dimen/gm_spacing_1"
        app:layout_constraintTop_toBottomOf="@id/heroBannerContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 总模块数 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statTotalCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="0" />

            <TextView
                android:id="@+id/statTotalTrend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/module_stat_total"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- 已安装 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gm_spacing_4"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statInstalledCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/success"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="0" />

            <TextView
                android:id="@+id/statInstalledTrend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/module_stat_installed"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- 有更新（statUpdateCard 保留 id 供未来跳转） -->
        <LinearLayout
            android:id="@+id/statUpdateCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gm_spacing_4"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statUpdateCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/warning"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="0" />

            <TextView
                android:id="@+id/statUpdateTrend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/module_stat_update"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="9sp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 一键更新（内联右侧，仅有更新时显示） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateAll"
            style="@style/Widget.GameMatrix.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="36dp"
            android:paddingHorizontal="@dimen/gm_spacing_2"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/module_update_all"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ===== 统计文本（无障碍 live region，视觉隐藏） ===== -->
    <TextView
        android:id="@+id/tvModuleStats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/gm_spacing_3"
        android:text="@string/module_refreshing"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/statsBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 搜索框（瘦身：44dp 单行，弱化外框） -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/moduleSearchLayout"
        style="@style/Widget.GameMatrix.Search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gm_spacing_3"
        android:layout_marginTop="@dimen/gm_spacing_1"
        android:layout_marginEnd="@dimen/gm_spacing_3"
        android:layout_marginBottom="@dimen/gm_spacing_1"
        android:hint="@string/module_search_hint"
        app:endIconMode="clear_text"
        app:startIconDrawable="@android:drawable/ic_menu_search"
        app:layout_constraintTop_toBottomOf="@id/tvModuleStats"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etModuleSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Batch 21: 搜索历史 chip 容器（仅 MODULE_STORE_SEARCH_HISTORY 开启时显示） -->
    <LinearLayout
        android:id="@+id/searchHistoryContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/gm_spacing_3"
        android:layout_marginEnd="@dimen/gm_spacing_3"
        android:layout_marginBottom="@dimen/gm_spacing_1"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/moduleSearchLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/module_search_history_title"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearchHistoryClear"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="32dp"
                android:paddingHorizontal="@dimen/gm_spacing_2"
                android:text="@string/module_search_history_clear"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/searchHistoryChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleLine="false"
            app:chipSpacingHorizontal="@dimen/gm_spacing_1"
            app:chipSpacingVertical="@dimen/gm_spacing_1" />
    </LinearLayout>

    <!-- 分类 Tab（含"已安装"独立 tab + 图标） -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/moduleCategoryTabs"
        style="@style/Widget.GameMatrix.Tab"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:elevation="@dimen/gm_elevation_1"
        app:tabMode="scrollable"
        app:tabGravity="start"
        app:layout_constraintTop_toBottomOf="@id/searchHistoryContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 子分类（游戏分类下显示，含"全部"） -->
    <HorizontalScrollView
        android:id="@+id/moduleSubCategoryContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceVariant"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/moduleCategoryTabs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/moduleSubCategoryTabs"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/gm_touch_target"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/gm_spacing_2"
            android:paddingEnd="@dimen/gm_spacing_2">
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ===== 可滚动内容区域（RecyclerView 正常回收复用，不再一次性测量所有 item） ===== -->
    <!-- P1 修复：height=0dp + 上接子分类栏、下接父容器底部，确保该区域始终获得确定的剩余高度，
         而非依赖 LinearLayout weight 在可见性切换后的偶发测量为 0。 -->
    <FrameLayout
        android:id="@+id/moduleListContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_min="120dp"
        app:layout_constraintTop_toBottomOf="@id/moduleSubCategoryContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 主列表（MODULE_STORE_PERF_OPT: match_parent + 默认 nestedScrolling=true，正常回收复用） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/moduleRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/gm_spacing_2" />

        <!-- 骨架屏 -->
        <LinearLayout
            android:id="@+id/moduleSkeletonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <include layout="@layout/item_module_skeleton" />
            <include layout="@layout/item_module_skeleton" />
            <include layout="@layout/item_module_skeleton" />
            <include layout="@layout/item_module_skeleton" />
            <include layout="@layout/item_module_skeleton" />
        </LinearLayout>

        <!-- 空状态（Batch 21: 增强视觉，渐变背景+大图标+描述+CTA） -->
        <LinearLayout
            android:id="@+id/moduleEmptyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/gm_spacing_6"
            android:paddingVertical="@dimen/gm_spacing_7"
            android:background="@drawable/module_empty_state_bg"
            android:layout_marginStart="@dimen/gm_spacing_3"
            android:layout_marginEnd="@dimen/gm_spacing_3"
            android:layout_marginTop="@dimen/gm_spacing_4"
            android:layout_marginBottom="@dimen/gm_spacing_4"
            android:visibility="gone">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/ic_empty_state_search"
                android:contentDescription="@null"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/moduleEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gm_spacing_4"
                android:text="@string/module_empty_title"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/moduleEmptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gm_spacing_2"
                android:text="@string/module_empty"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyAction"
                style="@style/Widget.GameMatrix.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gm_spacing_4"
                android:minHeight="@dimen/gm_touch_target"
                android:text="@string/module_empty_action"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 错误状态（Batch 21: 增强视觉，渐变背景+大图标+标题+描述+重试） -->
        <LinearLayout
            android:id="@+id/moduleErrorContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/gm_spacing_6"
            android:paddingVertical="@dimen/gm_spacing_7"
            android:background="@drawable/module_error_state_bg"
            android:layout_marginStart="@dimen/gm_spacing_3"
            android:layout_marginEnd="@dimen/gm_spacing_3"
            android:layout_marginTop="@dimen/gm_spacing_4"
            android:layout_marginBottom="@dimen/gm_spacing_4"
            android:visibility="gone">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/ic_error_state_cloud"
                android:contentDescription="@null"
                app:tint="?attr/colorError" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gm_spacing_4"
                android:text="@string/module_error_title"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/moduleErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gm_spacing_2"
                android:gravity="center"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                style="@style/Widget.GameMatrix.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gm_spacing_4"
                android:minHeight="@dimen/gm_touch_target"
                android:text="@string/module_retry" />
        </LinearLayout>
    </FrameLayout>

    <!-- 下拉刷新 FAB（替代原 SwipeRefreshLayout，因 NestedScrollView 不兼容） -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/moduleFabRefresh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/gm_spacing_4"
        android:contentDescription="@string/module_retry"
        android:src="@android:drawable/ic_popup_sync"
        app:tint="?attr/colorOnPrimary"
        app:backgroundTint="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
