<?xml version="1.0" encoding="utf-8"?>
<!-- 首页 V2 今日推荐大图卡（HOME_REVAMP_V2, 2026-07-22）
     - 160dp 高，游戏图标作为背景 + 底部渐变蒙版衬托文字
     - 内容：徽章"今日精选" + 游戏名（大字）+ 描述 + 立即开始按钮
     - 保留原 id：iv_game_of_day_icon / tv_game_of_day_name / tv_game_of_day_desc / btn_game_of_day_play
     - 圆角 20dp + 品红描边 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:background="@drawable/bg_home_v2_hero_card"
    android:clipToOutline="true"
    android:elevation="@dimen/elevation_medium">

    <!-- 背景层：游戏图标（大尺寸、半透明，作为视觉背景） -->
    <ImageView
        android:id="@+id/iv_game_of_day_icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.35"
        android:contentDescription="@string/home_game_of_day_title"
        app:srcCompat="@drawable/ic_game" />

    <!-- 底部渐变蒙版（衬托文字可读性） -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home_v2_hero_card_overlay" />

    <!-- 内容层 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_16"
        android:paddingTop="@dimen/spacing_12"
        android:paddingBottom="@dimen/spacing_16">

        <!-- 徽章行：今日精选 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_v2_badge"
            android:paddingStart="@dimen/spacing_8"
            android:paddingEnd="@dimen/spacing_8"
            android:paddingTop="@dimen/spacing_2"
            android:paddingBottom="@dimen/spacing_2"
            android:text="@string/home_v2_featured_today"
            android:textColor="@color/home_v2_hero_on_color"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_6" />

        <!-- 游戏名 -->
        <TextView
            android:id="@+id/tv_game_of_day_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/home_v2_hero_on_color"
            android:textSize="20sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            tools:text="五子棋" />

        <!-- 描述 -->
        <TextView
            android:id="@+id/tv_game_of_day_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2"
            android:textColor="@color/home_v2_hero_on_color_variant"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 立即开始按钮 -->
        <TextView
            android:id="@+id/btn_game_of_day_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:background="@drawable/bg_home_v2_play_btn"
            android:paddingStart="@dimen/spacing_16"
            android:paddingEnd="@dimen/spacing_16"
            android:paddingTop="@dimen/spacing_6"
            android:paddingBottom="@dimen/spacing_6"
            android:text="@string/home_game_of_day_play"
            android:textColor="#1A0B2E"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</FrameLayout>
