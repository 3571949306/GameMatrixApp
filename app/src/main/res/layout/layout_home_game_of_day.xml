<?xml version="1.0" encoding="utf-8"?>
<!-- Batch 10-2 (HOME_GAME_OF_DAY): 首页"今日推荐"卡片 - 标题 + 游戏名 + 描述 + 立即开始按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_16"
    android:layout_marginEnd="@dimen/spacing_16"
    android:background="@drawable/bg_game_of_day_gradient"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="@dimen/spacing_16"
    android:elevation="2dp">

    <!-- 左侧：游戏图标 -->
    <ImageView
        android:id="@+id/iv_game_of_day_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/home_game_of_day_title"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/ic_game"
        app:tint="@color/top_bar_on_gradient" />

    <!-- 中间：标题 + 游戏名 + 描述 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/spacing_12"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_game_of_day_title"
            android:textColor="#CCFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_game_of_day_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/top_bar_on_gradient"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_game_of_day_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 右侧：立即开始按钮 -->
    <TextView
        android:id="@+id/btn_game_of_day_play"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_8"
        android:background="@drawable/bg_game_of_day_btn"
        android:paddingStart="@dimen/spacing_12"
        android:paddingEnd="@dimen/spacing_12"
        android:paddingTop="@dimen/spacing_6"
        android:paddingBottom="@dimen/spacing_6"
        android:text="@string/home_game_of_day_play"
        android:textColor="#FF5722"
        android:textSize="12sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
