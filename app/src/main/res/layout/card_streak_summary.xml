<?xml version="1.0" encoding="utf-8"?>
<!-- Feature A: 连胜概览卡片 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_streak_summary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="12dp"
    android:padding="20dp"
    android:background="@drawable/bg_streak_card"
    android:elevation="3dp">

    <!-- 标题行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_streak_fire"
            app:tint="@color/streak_card_text"
            android:contentDescription="@string/streak_title" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/streak_title"
            android:textColor="@color/streak_card_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_streak_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/streak_card_text"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="0 天" />
    </LinearLayout>

    <!-- 三栏数据 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp"
        android:weightSum="3">

        <!-- 当前连胜 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_streak_current_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/streak_card_text"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/streak_current_days"
                android:textColor="@color/streak_card_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 最佳连胜 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_streak_best_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/streak_card_text"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/streak_best_days"
                android:textColor="@color/streak_card_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 总对局 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_streak_total_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/streak_card_text"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/streak_total_games"
                android:textColor="@color/streak_card_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
