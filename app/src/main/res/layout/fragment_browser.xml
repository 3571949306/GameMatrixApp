<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/browser_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceContainer"
            android:elevation="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/gm_spacing_2">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/browser_back"
                android:src="@drawable/ic_browser_back"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btn_forward"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/browser_forward"
                android:src="@drawable/ic_browser_forward"
                app:tint="?attr/colorOnSurface" />

            <EditText
                android:id="@+id/et_url"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_url_bar"
                android:hint="@string/browser_url_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="@dimen/gm_spacing_3"
                android:paddingEnd="@dimen/gm_spacing_3"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/incognito_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gm_spacing_1"
                android:background="?attr/colorPrimaryContainer"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/browser_incognito_indicator"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="11sp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_refresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/browser_refresh"
                android:src="@drawable/ic_browser_refresh"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btn_more"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/browser_more"
                android:src="@drawable/ic_browser_more"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- ===== Find In Page Bar（默认隐藏） ===== -->
        <LinearLayout
            android:id="@+id/find_in_page_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceContainer"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/gm_spacing_2"
            android:paddingEnd="@dimen/gm_spacing_2"
            android:paddingTop="@dimen/gm_spacing_1"
            android:paddingBottom="@dimen/gm_spacing_1"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btn_find_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/browser_find_close"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorOnSurface" />

            <EditText
                android:id="@+id/et_find_query"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/gm_spacing_1"
                android:layout_marginEnd="@dimen/gm_spacing_1"
                android:background="@android:color/transparent"
                android:hint="@string/browser_find_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_find_match_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:paddingStart="@dimen/gm_spacing_1"
                android:paddingEnd="@dimen/gm_spacing_1"
                android:text="0/0"
                android:textAlignment="center"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btn_find_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/browser_find_prev"
                android:src="@drawable/ic_browser_back"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btn_find_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/browser_find_next"
                android:src="@drawable/ic_browser_forward"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_bar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progressTint="?attr/colorPrimary"
            android:progressBackgroundTint="?attr/colorSurfaceVariant"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/webview_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 浏览器起始页（默认隐藏，新建标签或访问 about:home 时显示） -->
            <FrameLayout
                android:id="@+id/browser_home_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- P3-4 页面加载骨架屏（默认隐藏，加载中显示） -->
            <include
                android:id="@+id/skeleton_overlay"
                layout="@layout/layout_browser_skeleton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- 内置视频播放器覆盖层挂载点（与视频画面同区域，叠加在 WebView 之上） -->
            <FrameLayout
                android:id="@+id/player_overlay_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/error_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_browser_error"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gm_spacing_4"
                android:text="@string/browser_error_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_error_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gm_spacing_2"
                android:gravity="center"
                android:paddingStart="@dimen/gm_spacing_7"
                android:paddingEnd="@dimen/gm_spacing_7"
                android:text="@string/browser_error_message"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gm_spacing_4"
                android:text="@string/browser_retry" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/browser_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/colorSurfaceContainer"
            android:elevation="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/browser_home"
                android:src="@drawable/ic_browser_home"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btn_bookmark"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/browser_bookmark"
                android:src="@drawable/ic_browser_bookmark"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btn_tabs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/browser_tabs"
                android:src="@drawable/ic_browser_tabs"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btn_download"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/browser_download"
                android:src="@drawable/ic_browser_download"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btn_menu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/browser_menu"
                android:src="@drawable/ic_browser_menu"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 内置播放器入口：检测到网页视频时浮出（夸克式） ===== -->
    <TextView
        android:id="@+id/btn_video_player_entry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/gm_spacing_3"
        android:layout_marginBottom="56dp"
        android:background="@drawable/bg_browser_player_hint"
        android:clickable="true"
        android:contentDescription="@string/browser_player_enter"
        android:focusable="true"
        android:paddingStart="@dimen/gm_spacing_4"
        android:paddingEnd="@dimen/gm_spacing_4"
        android:paddingTop="@dimen/gm_spacing_2"
        android:paddingBottom="@dimen/gm_spacing_2"
        android:text="@string/browser_player_enter"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- ===== 手势视觉反馈：左边缘箭头（默认隐藏） ===== -->
    <ImageView
        android:id="@+id/gesture_left_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="@dimen/gm_spacing_6"
        android:alpha="0"
        android:background="@drawable/bg_gesture_indicator"
        android:contentDescription="@string/browser_gesture_back_desc"
        android:padding="@dimen/gm_spacing_3"
        android:src="@drawable/ic_browser_back"
        android:visibility="gone"
        app:tint="?attr/colorOnPrimary" />

    <!-- ===== 手势视觉反馈：右边缘箭头（默认隐藏） ===== -->
    <ImageView
        android:id="@+id/gesture_right_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="@dimen/gm_spacing_6"
        android:alpha="0"
        android:background="@drawable/bg_gesture_indicator"
        android:contentDescription="@string/browser_gesture_forward_desc"
        android:padding="@dimen/gm_spacing_3"
        android:src="@drawable/ic_browser_forward"
        android:visibility="gone"
        app:tint="?attr/colorOnPrimary" />

</FrameLayout>
