<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/gm_spacing_7">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="@dimen/gm_spacing_6"
            android:contentDescription="@string/recovery_icon_desc"
            android:src="@android:drawable/ic_menu_manage" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gm_spacing_4"
            android:text="@string/recovery_title"
            android:textColor="#333333"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/recoveryStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gm_spacing_3"
            android:gravity="center"
            android:text="@string/recovery_status_ready"
            android:textColor="#666666"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/recoveryProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="@dimen/gm_spacing_6"
            android:max="100"
            android:progress="0"
            android:progressTint="#4CAF50" />

        <TextView
            android:id="@+id/recoveryProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gm_spacing_2"
            android:textColor="#999999"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/recoverySourceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gm_spacing_1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="#AAAAAA"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/recoveryErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gm_spacing_4"
            android:background="#FFF3F3"
            android:padding="@dimen/gm_spacing_3"
            android:textColor="#D32F2F"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/recoveryDownloadBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/gm_spacing_6"
            android:backgroundTint="#4CAF50"
            android:text="@string/recovery_btn_download"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/recoveryInstallBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/gm_spacing_2"
            android:backgroundTint="#2196F3"
            android:enabled="false"
            android:text="@string/recovery_btn_install"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/recoveryRetryBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/gm_spacing_2"
            android:backgroundTint="#FF9800"
            android:text="@string/recovery_btn_retry"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/recoveryCancelBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/gm_spacing_2"
            android:backgroundTint="#9E9E9E"
            android:text="@string/recovery_btn_cancel"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gm_spacing_7"
            android:text="@string/recovery_hint"
            android:textColor="#999999"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
