<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gm_spacing_3"
        android:hint="@string/tool_qr_plus_input_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_qr_plus_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:minLines="2"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gm_spacing_2"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_qr_plus_generate"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:text="@string/tool_qr_plus_generate"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_qr_plus_decode_image"
            style="@style/Widget.GameMatrix.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:text="@string/tool_qr_plus_decode_image"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_qr_plus_clipboard"
            style="@style/Widget.GameMatrix.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:text="@string/tool_qr_plus_clipboard"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_qr_plus_wifi"
            style="@style/Widget.GameMatrix.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:text="@string/tool_qr_plus_wifi"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_qr_plus_vcard"
            style="@style/Widget.GameMatrix.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:text="@string/tool_qr_plus_vcard"
            android:textSize="12sp" />

    </LinearLayout>

    <ImageView
        android:id="@+id/iv_qr_plus"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/gm_spacing_3"
        android:contentDescription="@string/tool_qr_plus_preview_desc"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_qr_plus_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gm_spacing_2"
        android:background="?attr/colorSurfaceVariant"
        android:fontFamily="monospace"
        android:lineSpacingExtra="4dp"
        android:padding="@dimen/gm_spacing_2"
        android:text="@string/tool_qr_plus_result_placeholder"
        android:textColor="?android:attr/textColorPrimary"
        android:textIsSelectable="true"
        android:textSize="13sp" />

</LinearLayout>
