<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/gm_spacing_2"
    android:layout_marginEnd="@dimen/gm_spacing_2"
    android:layout_marginBottom="@dimen/gm_spacing_3"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="?attr/colorSurface"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/gm_spacing_4">

        <!-- Module Icon -->
        <FrameLayout
            android:id="@+id/installedIconContainer"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/game_icon_bg_gradient"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/installedItemIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:contentDescription="@string/module_icon_desc" />

            <!-- Enabled/Disabled Indicator -->
            <View
                android:id="@+id/installedItemStatusIndicator"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/badge_new_bg"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Content Layout -->
        <LinearLayout
            android:id="@+id/installedContentLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gm_spacing_4"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/installedIconContainer"
            app:layout_constraintEnd_toStartOf="@id/installedActionLayout"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Title Row: Name + Category Chip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/installedItemName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/installedItemCategoryChip"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gm_spacing_2"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Version -->
            <TextView
                android:id="@+id/installedItemVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gm_spacing_1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <!-- Status Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/installedItemStatusChip"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="10sp"
                android:visibility="gone" />

            <!-- Enable/Disable Switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gm_spacing_2"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="启用"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/installedItemEnableSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gm_spacing_2"
                    android:checked="true"
                    app:thumbTint="?attr/colorPrimary"
                    app:trackTint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/installedItemStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gm_spacing_2"
                    android:text="已启用"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Progress Bar -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/installedItemProgress"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="@dimen/gm_spacing_2"
                android:max="100"
                android:progress="0"
                app:indicatorColor="?attr/colorPrimary"
                app:trackColor="?attr/colorSurfaceVariant"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/installedActionLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gm_spacing_3"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/installedItemUpdateBtn"
                style="@style/Widget.Material3.Button.Tonal"
                android:layout_width="88dp"
                android:layout_height="36dp"
                android:paddingStart="@dimen/gm_spacing_2"
                android:paddingEnd="@dimen/gm_spacing_2"
                android:text="@string/installed_update"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/installedItemUninstallBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="88dp"
                android:layout_height="36dp"
                android:layout_marginTop="@dimen/gm_spacing_2"
                android:paddingStart="@dimen/gm_spacing_2"
                android:paddingEnd="@dimen/gm_spacing_2"
                android:text="@string/installed_uninstall"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

        <!-- Built-in Chip (if applicable) -->
        <com.google.android.material.chip.Chip
            android:id="@+id/installedItemBuiltInChip"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="内置"
            android:textSize="10sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="@dimen/gm_spacing_3"
            android:layout_marginTop="@dimen/gm_spacing_2" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
