<?xml version="1.0" encoding="utf-8"?>
<!-- 每日签到对话框布局（Feature: DAILY_CHECKIN），所有颜色引用 ?attr/ 支持浅深色主题 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?attr/colorSurface">

    <!-- 顶部图标 -->
    <ImageView
        android:id="@+id/iv_checkin_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:contentDescription="@string/daily_checkin_title"
        android:src="@drawable/ic_checkin_calendar"
        app:tint="?attr/colorPrimary" />

    <!-- 标题 -->
    <TextView
        android:id="@+id/tv_checkin_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/daily_checkin_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- 副标题 -->
    <TextView
        android:id="@+id/tv_checkin_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/daily_checkin_subtitle"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp" />

    <!-- 连续签到天数 + 今日奖励 卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_checkin_card"
        android:padding="16dp">

        <!-- 左：连续签到天数 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_checkin_consecutive_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/daily_checkin_consecutive"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_checkin_consecutive_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorPrimary"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="3 天" />
        </LinearLayout>

        <!-- 右：今日奖励标签 -->
        <TextView
            android:id="@+id/tv_checkin_today_reward_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/daily_checkin_today_reward"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" />

        <!-- 最右：今日奖励数值 -->
        <TextView
            android:id="@+id/tv_checkin_today_reward_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:textColor="?attr/colorPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="+7 积分" />
    </LinearLayout>

    <!-- 中断警告 -->
    <TextView
        android:id="@+id/tv_checkin_break_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/daily_checkin_break_warning"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp" />

    <!-- 签到按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_checkin"
        style="@style/Widget.GameMatrix.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/daily_checkin_btn" />

    <!-- 已签到状态文本（默认隐藏） -->
    <TextView
        android:id="@+id/tv_checkin_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/daily_checkin_done_today"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
