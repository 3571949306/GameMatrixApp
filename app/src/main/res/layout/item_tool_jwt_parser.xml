<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-07-25: JWT 解析工具布局 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gm_spacing_3"
        android:hint="@string/tool_jwt_input_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_jwt_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:maxLines="6"
            android:minLines="2" />

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gm_spacing_2"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_jwt_decode"
            style="@style/Widget.GameMatrix.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/tool_jwt_decode" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_jwt_copy"
            style="@style/Widget.GameMatrix.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/gm_spacing_2"
            android:layout_weight="1"
            android:text="@string/tool_jwt_copy" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gm_spacing_2"
        android:text="@string/tool_jwt_header_label"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_jwt_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceVariant"
        android:fontFamily="monospace"
        android:padding="@dimen/gm_spacing_2"
        android:textColor="?android:attr/textColorPrimary"
        android:textIsSelectable="true"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/tool_jwt_payload_label"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_jwt_payload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceVariant"
        android:fontFamily="monospace"
        android:padding="@dimen/gm_spacing_2"
        android:textColor="?android:attr/textColorPrimary"
        android:textIsSelectable="true"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/tool_jwt_signature_label"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_jwt_signature"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceVariant"
        android:fontFamily="monospace"
        android:padding="@dimen/gm_spacing_2"
        android:textColor="?android:attr/textColorPrimary"
        android:textIsSelectable="true"
        android:textSize="12sp" />
</LinearLayout>
