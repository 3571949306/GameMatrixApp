<?xml version="1.0" encoding="utf-8"?>
<!-- 首页 V2 游戏活力风重设计 (HOME_REVAMP_V2, 2026-07-22)
     - 游戏霓虹配色（深紫→品红→暖橙 浅色；深紫黑→品红紫→霓虹紫 深色）
     - 3 层信息架构：L1 沉浸式 Hero（问候/搜索/今日推荐大图卡/统计）→ L2 快速入口带（继续游玩/最近游玩/每日卡片）→ L3 游戏列表（筛选/Tab/网格）
     - 弱化：时长提醒、最近成就、Hero Banner 轮播（保留 id 但默认 GONE）
     - 保留全部 37 个原 id，GamesFragment.java 业务逻辑不变
     - 浅色/深色主题由 values/colors.xml + values-night/colors.xml 的 home_v2_* 色板自动适配 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============================================================ -->
            <!-- L1 沉浸式 Hero 区：游戏霓虹渐变，融合问候/搜索/今日推荐大图卡/统计 -->
            <!-- ============================================================ -->
            <!-- top_bar id 保留（原顶栏容器），现扩展为 Hero 区根容器 -->
            <LinearLayout
                android:id="@+id/top_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_home_v2_hero"
                android:paddingTop="@dimen/spacing_20"
                android:paddingStart="@dimen/spacing_20"
                android:paddingEnd="@dimen/spacing_20"
                android:paddingBottom="@dimen/spacing_16">

                <!-- Hero 顶行：问候语 + 通知 + 头像 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_16">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_greeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/home_v2_hero_on_color"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="下午好，玩家" />

                        <TextView
                            android:id="@+id/tv_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_2"
                            android:textColor="@color/home_v2_hero_on_color_variant"
                            android:textSize="12sp"
                            tools:text="今天玩点什么？" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btn_notification"
                        android:layout_width="@dimen/icon_size_large"
                        android:layout_height="@dimen/icon_size_large"
                        android:layout_marginEnd="@dimen/spacing_12"
                        android:src="@drawable/ic_notification"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/notifications"
                        android:clickable="true"
                        android:focusable="true"
                        app:tint="@color/home_v2_hero_on_color" />

                    <ImageView
                        android:id="@+id/btn_avatar"
                        android:layout_width="@dimen/icon_size_xlarge"
                        android:layout_height="@dimen/icon_size_xlarge"
                        android:src="@drawable/ic_avatar_placeholder"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/profile"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- 搜索药丸（search_layout id 保留） -->
                <LinearLayout
                    android:id="@+id/search_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_home_v2_search_pill"
                    android:paddingStart="@dimen/spacing_16"
                    android:paddingEnd="@dimen/spacing_16"
                    android:paddingTop="@dimen/spacing_12"
                    android:paddingBottom="@dimen/spacing_12"
                    android:layout_marginBottom="@dimen/spacing_16">

                    <ImageView
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:layout_marginEnd="@dimen/spacing_12"
                        android:src="@drawable/ic_search"
                        android:contentDescription="@null"
                        app:tint="@color/home_v2_search_pill_hint" />

                    <EditText
                        android:id="@+id/et_game_search"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/search_game_hint"
                        android:textColorHint="@color/home_v2_search_pill_hint"
                        android:textColor="@color/home_v2_search_pill_text"
                        android:textSize="14sp"
                        android:inputType="text"
                        android:imeOptions="actionSearch"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- 搜索历史区（search_history_section id 保留，默认隐藏） -->
                <LinearLayout
                    android:id="@+id/search_history_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_8">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/search_history_section_title"
                            android:textColor="@color/home_v2_hero_on_color_variant"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btn_search_history_clear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/spacing_8"
                            android:paddingEnd="@dimen/spacing_8"
                            android:paddingTop="@dimen/spacing_4"
                            android:paddingBottom="@dimen/spacing_4"
                            android:text="@string/home_recent_clear"
                            android:textColor="@color/home_v2_hero_on_color"
                            android:textSize="11sp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_search_history"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- 今日推荐大图卡（game_of_day_section）已移除（HOME_NO_TODAY_FEATURED_2026_07_24）
                     移除原因：与 L2 跳棋/今日精选/连胜记录等内容重复，挤占首屏。
                     GamesFragment 中 initGameOfDay/refreshGameOfDay 代码保留（含 null check），
                     XML 节点删后 findViewById 返回 null，方法早返回，不再渲染。 -->

                <!-- 快速统计行（quick_stats_section id 保留，Hero 内嵌） -->
                <LinearLayout
                    android:id="@+id/quick_stats_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_home_v2_stat_pill"
                    android:padding="@dimen/spacing_12">

                    <!-- 今日时长 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_stat_playtime_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/home_v2_hero_on_color"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="0h 0m" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_2"
                            android:text="@string/home_stat_today_playtime"
                            android:textColor="@color/home_v2_hero_on_color_variant"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- 连胜 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_stat_streak_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/home_v2_hero_on_color"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="0 天" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_2"
                            android:text="@string/home_stat_streak"
                            android:textColor="@color/home_v2_hero_on_color_variant"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- 成就 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_stat_achievements_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/home_v2_hero_on_color"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_2"
                            android:text="@string/home_stat_achievements"
                            android:textColor="@color/home_v2_hero_on_color_variant"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 游戏时长提醒（playtime_reminder_section id 保留，默认隐藏，V2 弱化） -->
                <FrameLayout
                    android:id="@+id/playtime_reminder_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:visibility="gone">

                    <include layout="@layout/layout_home_playtime_reminder" />
                </FrameLayout>
            </LinearLayout>

            <!-- ============================================================ -->
            <!-- L2 快速入口带（重构 HOME_L2_GRID_2026_07_24 v7）：
                 两行 × 两列 × 四象限的紧凑方阵，用"固定行高 + 子 view match_parent"
                 实现同行两卡必然等高（消除割裂感）：
                   - 外层 vertical LinearLayout（单一 marginStart/End=16dp + marginTop=12dp）
                   - Row 1 / Row 2 各为 horizontal LinearLayout，固定 layout_height=190dp
                   - Row 内左右两 card 都用"FrameLayout/LinearLayout 包装 + 内部 include(match_parent)"
                     → 每个卡片都 match_parent 撑满 190dp 行高，同行两卡必然等高
                   - 左/右各 weight=1（占 50%）；Row 间 marginTop=6dp；卡片间 marginEnd/Start=6dp
                 注：include 必须包一层容器，避免"include 直接作子 view + match_parent"解析失效。
                 全部 id 保留，GamesFragment.findViewById 关系不变。
                 daily_cards_section 退化为"每日挑战单卡容器"，仍作 VISIBLE 开关。 -->

            <!-- L2 整体外层容器：单一外边距，让 2×2 网格视觉��体 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/spacing_16"
                android:layout_marginEnd="@dimen/spacing_16"
                android:layout_marginTop="@dimen/spacing_12">

                <!-- Row 1（固定行高 150dp）：继续游玩（左半）+ 每日挑战（右半） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:orientation="horizontal">

                    <!-- 继续游玩（左半：weight=1，包装层 match_parent 撑满行高） -->
                    <FrameLayout
                    android:id="@+id/resume_game_section"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_4"
                    android:visibility="gone">

                        <include
                            layout="@layout/layout_home_resume_game"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </FrameLayout>

                    <!-- 每日挑战（右半：weight=1，daily_cards_section 退化为单卡容器） -->
                    <LinearLayout
                        android:id="@+id/daily_cards_section"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_4"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <include
                            android:id="@+id/card_daily_challenge_include"
                            layout="@layout/card_daily_challenge"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2（自适应高度 = streak 决定）：今日精选（左半）+ 连胜记录（右半） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:orientation="horizontal">

                    <!-- 今日精选（左半：weight=1，wrap_content 自适应） -->
                    <FrameLayout
                        android:id="@+id/card_today_featured_include"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_4">

                        <include
                            layout="@layout/card_today_featured"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </FrameLayout>

                    <!-- 连胜记录（右半：weight=1，wrap_content 自适应，Row 2 高度 = streak） -->
                    <FrameLayout
                        android:id="@+id/card_streak_summary_include"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_4">

                        <include
                            layout="@layout/card_streak_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 最近游玩（recent_games_section id 保留，横向卡片带） -->
            <LinearLayout
                android:id="@+id/recent_games_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/spacing_12"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_16"
                    android:paddingEnd="@dimen/spacing_16"
                    android:paddingBottom="@dimen/spacing_6">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_recent_games"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_recent_clear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/spacing_8"
                        android:paddingEnd="@dimen/spacing_8"
                        android:paddingTop="@dimen/spacing_4"
                        android:paddingBottom="@dimen/spacing_4"
                        android:text="@string/home_recent_clear"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="11sp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/recent_games_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/spacing_16"
                        android:paddingEnd="@dimen/spacing_16" />

                </HorizontalScrollView>
            </LinearLayout>

            <!-- Hero Banner 轮播（hero_banner_section id 保留，V2 弱化为 GONE 占位） -->
            <LinearLayout
                android:id="@+id/hero_banner_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/spacing_16"
                android:layout_marginEnd="@dimen/spacing_16"
                android:layout_marginTop="@dimen/spacing_8"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_hero_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never" />

                <LinearLayout
                    android:id="@+id/hero_indicator_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/spacing_8" />
            </LinearLayout>

            <!-- 最近成就（recent_achievement_section id 保留，V2 弱化为 GONE 占位） -->
            <FrameLayout
                android:id="@+id/recent_achievement_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_16"
                android:layout_marginEnd="@dimen/spacing_16"
                android:layout_marginTop="@dimen/spacing_8"
                android:visibility="gone">

                <include layout="@layout/layout_home_recent_achievement" />
            </FrameLayout>

            <!-- ============================================================ -->
            <!-- L3 游戏列表区：筛选 Chip + Tab + 网格                          -->
            <!-- ============================================================ -->

            <!-- 收藏筛选 chip 行（chip_group_filter id 保留，默认隐藏） -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_16"
                android:layout_marginEnd="@dimen/spacing_16"
                android:layout_marginTop="@dimen/spacing_8"
                android:visibility="gone"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_all"
                    style="@style/Widget.GameMatrix.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/filter_all_games" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_favorites"
                    style="@style/Widget.GameMatrix.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="@string/filter_favorites_only" />
            </com.google.android.material.chip.ChipGroup>

            <!-- 分类标签（tab_scroll / tab_layout id 保留） -->
            <HorizontalScrollView
                android:id="@+id/tab_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:scrollbars="none">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_layout"
                    style="@style/Widget.GameMatrix.Tab"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/spacing_40"
                    android:layout_marginStart="@dimen/spacing_16"
                    android:layout_marginEnd="@dimen/spacing_16"
                    android:background="@android:color/transparent"
                    app:tabMode="scrollable" />

            </HorizontalScrollView>

            <!-- 游戏区域 overlay 容器：SwipeRefreshLayout(游戏网格) + shimmer + empty_state 叠加 -->
            <FrameLayout
                android:id="@+id/game_area_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:minHeight="@dimen/home_game_grid_min_height">

                <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_games"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:paddingStart="@dimen/spacing_12"
                        android:paddingEnd="@dimen/spacing_12"
                        android:paddingBottom="@dimen/spacing_16"
                        android:clipToPadding="false"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="2"
                        tools:listitem="@layout/item_game_card" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_shimmer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="@dimen/spacing_12"
                    android:paddingEnd="@dimen/spacing_12"
                    android:paddingBottom="@dimen/spacing_16"
                    android:clipToPadding="false"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="2"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tv_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/spacing_32"
                    android:layout_marginEnd="@dimen/spacing_32"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <include
                    android:id="@+id/empty_state_illustration"
                    layout="@layout/layout_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- 随机游戏 FAB（fab_random_game id 保留，默认隐藏） -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_random_game"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/spacing_16"
        android:layout_marginBottom="@dimen/spacing_80"
        android:src="@drawable/ic_dice"
        android:contentDescription="@string/random"
        android:visibility="gone"
        app:tint="@color/home_v2_hero_on_color"
        app:backgroundTint="@color/home_v2_hero_center" />

</FrameLayout>
