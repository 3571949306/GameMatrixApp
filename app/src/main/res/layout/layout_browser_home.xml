<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/gm_spacing_9"
            android:paddingBottom="@dimen/gm_spacing_7">

            <!-- 顶部 Logo + 标语 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/browser_home_title"
                android:textColor="?attr/colorPrimary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- 搜索框（点击后切换到 URL Bar 输入） -->
            <LinearLayout
                android:id="@+id/home_search_box"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/gm_spacing_5"
                android:layout_marginTop="@dimen/gm_spacing_6"
                android:layout_marginEnd="@dimen/gm_spacing_5"
                android:background="@drawable/bg_home_search_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/gm_spacing_4"
                android:paddingEnd="@dimen/gm_spacing_4">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/browser_search"
                    android:src="@drawable/ic_search"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gm_spacing_3"
                    android:layout_weight="1"
                    android:hint="@string/browser_home_search_hint"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- ===== Grid 风格容器（垂直 LinearLayout 包含两行水平 LinearLayout） ===== -->
            <LinearLayout
                android:id="@+id/home_grid_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gm_spacing_4"
                android:layout_marginTop="@dimen/gm_spacing_7"
                android:layout_marginEnd="@dimen/gm_spacing_4"
                android:orientation="vertical" />

            <!-- ===== Cards 风格容器（横向滚动） ===== -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gm_spacing_7"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/home_cards_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/gm_spacing_4"
                    android:paddingEnd="@dimen/gm_spacing_4" />
            </HorizontalScrollView>

            <!-- ===== Minimal 风格容器 ===== -->
            <LinearLayout
                android:id="@+id/home_minimal_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gm_spacing_5"
                android:layout_marginTop="@dimen/gm_spacing_9"
                android:layout_marginEnd="@dimen/gm_spacing_5"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/browser_home_quick_entry"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ===== 快捷入口（书签/历史/阅读列表） ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gm_spacing_5"
                android:layout_marginTop="@dimen/gm_spacing_7"
                android:layout_marginEnd="@dimen/gm_spacing_5"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/home_entry_bookmarks"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/gm_spacing_3">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/browser_bookmark"
                        android:src="@drawable/ic_browser_bookmark"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/browser_bookmark"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/home_entry_history"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/gm_spacing_3">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/browser_history"
                        android:src="@drawable/ic_history"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/browser_history"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/home_entry_reading_list"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/gm_spacing_3">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/browser_reading_list"
                        android:src="@drawable/ic_browser_bookmark"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/browser_reading_list"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
