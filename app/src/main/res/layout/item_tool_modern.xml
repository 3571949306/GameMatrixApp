<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_tool"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/gm_spacing_4"
    android:layout_marginEnd="@dimen/gm_spacing_4"
    android:layout_marginBottom="@dimen/gm_spacing_3"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="0.5dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:paddingStart="@dimen/gm_spacing_4"
        android:paddingEnd="@dimen/gm_spacing_4"
        android:paddingTop="@dimen/gm_spacing_3"
        android:paddingBottom="@dimen/gm_spacing_3">

        <!-- 左侧圆形图标容器 -->
        <ImageView
            android:id="@+id/iv_tool_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_tool_icon_circle"
            android:padding="@dimen/gm_spacing_3"
            android:scaleType="centerInside"
            app:tint="@android:color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 工具名称 -->
        <TextView
            android:id="@+id/tv_tool_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gm_spacing_4"
            android:text="Tool Name"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/iv_tool_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/iv_chevron"
            android:layout_marginEnd="@dimen/gm_spacing_2" />

        <!-- 工具描述 -->
        <TextView
            android:id="@+id/tv_tool_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gm_spacing_4"
            android:layout_marginTop="2dp"
            android:text="Tool description"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/iv_tool_icon"
            app:layout_constraintTop_toBottomOf="@id/tv_tool_name"
            app:layout_constraintEnd_toStartOf="@id/iv_chevron"
            android:layout_marginEnd="@dimen/gm_spacing_2" />

        <!-- 右侧箭头图标 -->
        <ImageView
            android:id="@+id/iv_chevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:visibility="visible" />

        <!-- 可选 Switch（默认隐藏） -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_tool"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
