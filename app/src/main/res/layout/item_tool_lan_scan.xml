<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <EditText
        android:id="@+id/et_lan_prefix"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/gm_spacing_3"
        android:hint="网段前缀，例如 192.168.1"
        android:inputType="text"
        android:textColor="?android:attr/textColorPrimary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_lan_scan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="扫描局域网设备" />

    <TextView
        android:id="@+id/tv_lan_scan_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gm_spacing_2"
        android:background="?attr/colorSurfaceVariant"
        android:fontFamily="monospace"
        android:lineSpacingExtra="4dp"
        android:padding="@dimen/gm_spacing_3"
        android:text="等待扫描"
        android:textColor="?android:attr/textColorPrimary"
        android:textIsSelectable="true"
        android:textSize="13sp" />
</LinearLayout>
