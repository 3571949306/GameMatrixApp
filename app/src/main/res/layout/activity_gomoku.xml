<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gomoku_main_bg"
    android:paddingTop="28dp">

    <com.gamecenter.app.games.gomoku.GomokuView
        android:id="@+id/gomoku_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 对局计时显示（仅游戏中可见） -->
    <TextView
        android:id="@+id/tv_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/gm_spacing_1"
        android:text="00:00"
        android:textColor="@color/gomoku_title_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 难度选择主面板：中央卡片样式 -->
    <ScrollView
        android:id="@+id/difficulty_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="@dimen/gm_spacing_5"
            android:paddingTop="@dimen/gm_spacing_3"
            android:paddingBottom="@dimen/gm_spacing_5">

            <!-- 中央卡片：包裹标题+难度+先手+开始按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/gomoku_main_card_bg"
                android:elevation="6dp"
                android:padding="@dimen/gm_spacing_5">

                <!-- 标题区 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/gomoku_main_title"
                    android:textColor="@color/gomoku_title_text"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="2dp"
                    android:text="@string/gomoku_main_subtitle"
                    android:textColor="@color/gomoku_subtitle_text"
                    android:textSize="13sp" />

                <!-- 分隔线 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/gomoku_card_border"
                    android:alpha="0.4" />

                <!-- 难度标签 -->
                <TextView
                    android:id="@+id/tv_difficulty_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/gomoku_difficulty_label_default"
                    android:textColor="@color/gomoku_subtitle_text"
                    android:textSize="14sp" />

                <!-- 难度2×2宫格 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/btn_difficulty_1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/gomoku_difficulty_selector"
                            android:padding="10dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="12dp"
                                android:src="@drawable/gomoku_stars_1"
                                android:contentDescription="@string/gomoku_difficulty_low" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/gomoku_difficulty_low"
                                android:textColor="@color/gomoku_difficulty_unselected"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/gomoku_difficulty_low_desc"
                                android:textColor="@color/gomoku_difficulty_unselected"
                                android:alpha="0.7"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btn_difficulty_2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/gomoku_difficulty_selector"
                            android:padding="10dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="12dp"
                                android:src="@drawable/gomoku_stars_2"
                                android:contentDescription="@string/gomoku_difficulty_medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/gomoku_difficulty_medium"
                                android:textColor="@color/gomoku_difficulty_unselected"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/gomoku_difficulty_medium_desc"
                                android:textColor="@color/gomoku_difficulty_unselected"
                                android:alpha="0.7"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gm_spacing_2"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/btn_difficulty_3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/gomoku_difficulty_selector"
                            android:padding="10dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="12dp"
                                android:src="@drawable/gomoku_stars_3"
                                android:contentDescription="@string/gomoku_difficulty_high" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/gomoku_difficulty_high"
                                android:textColor="@color/gomoku_difficulty_unselected"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/gomoku_difficulty_high_desc"
                                android:textColor="@color/gomoku_difficulty_unselected"
                                android:alpha="0.7"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btn_difficulty_4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/gomoku_difficulty_selector"
                            android:padding="10dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="12dp"
                                android:src="@drawable/gomoku_stars_4"
                                android:contentDescription="@string/gomoku_difficulty_master" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/gomoku_difficulty_master"
                                android:textColor="@color/gomoku_difficulty_unselected"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/gomoku_difficulty_master_desc"
                                android:textColor="@color/gomoku_difficulty_unselected"
                                android:alpha="0.7"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- 先手选择标签 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp"
                    android:text="@string/gomoku_select_color"
                    android:textColor="@color/gomoku_subtitle_text"
                    android:textSize="14sp" />

                <!-- 先手选择：黑白棋子卡片 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gm_spacing_2"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btn_color_black"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/gomoku_color_selector"
                        android:padding="@dimen/gm_spacing_3"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/gomoku_piece_black"
                            android:contentDescription="@string/gomoku_play_black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/gm_spacing_2"
                            android:text="@string/gomoku_play_black"
                            android:textColor="@color/gomoku_difficulty_unselected"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_color_white"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/gomoku_color_selector"
                        android:padding="@dimen/gm_spacing_3"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/gomoku_piece_white"
                            android:contentDescription="@string/gomoku_play_white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/gm_spacing_2"
                            android:text="@string/gomoku_play_white"
                            android:textColor="@color/gomoku_difficulty_unselected"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 开始游戏按钮 -->
                <TextView
                    android:id="@+id/btn_start_game"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/gomoku_start_btn_bg"
                    android:gravity="center"
                    android:text="@string/gomoku_start_game"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="4dp" />

            </LinearLayout>

            <!-- 教程按钮（卡片外） -->
            <TextView
                android:id="@+id/btn_tutorial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gm_spacing_4"
                android:padding="@dimen/gm_spacing_2"
                android:text="@string/gomoku_tutorial"
                android:textColor="@color/gomoku_subtitle_text"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </ScrollView>

    <!-- 游戏控制面板（仅游戏中可见） -->
    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/gm_spacing_4"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_undo"
                style="@style/Widget.GameMatrix.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="@dimen/gm_spacing_1"
                android:layout_weight="1"
                android:text="@string/btn_undo"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hint"
                style="@style/Widget.GameMatrix.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="@dimen/gm_spacing_1"
                android:layout_weight="1"
                android:text="@string/gomoku_hint"
                android:textSize="13sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_restart"
                style="@style/Widget.GameMatrix.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="@dimen/gm_spacing_1"
                android:layout_weight="1"
                android:text="@string/btn_restart"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_resign"
                style="@style/Widget.GameMatrix.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="@dimen/gm_spacing_1"
                android:layout_weight="1"
                android:text="@string/gomoku_resign"
                android:textSize="13sp" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tutorial_ingame"
            style="@style/Widget.GameMatrix.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="@dimen/gm_spacing_1"
            android:text="@string/gomoku_tutorial"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
