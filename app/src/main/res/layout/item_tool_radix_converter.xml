<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-07-25: 进制转换工具布局 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <Spinner
        android:id="@+id/sp_radix_input_base"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gm_spacing_3" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gm_spacing_2"
        android:hint="@string/tool_radix_input_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_radix_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:inputType="textNoSuggestions" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_radix_convert"
        style="@style/Widget.GameMatrix.Button.Tonal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/gm_spacing_2"
        android:text="@string/tool_regex_test_label" />

    <TextView
        android:id="@+id/tv_radix_bin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gm_spacing_2"
        android:background="?attr/colorSurfaceVariant"
        android:fontFamily="monospace"
        android:padding="@dimen/gm_spacing_2"
        android:textColor="?android:attr/textColorPrimary"
        android:textIsSelectable="true"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_radix_oct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gm_spacing_1"
        android:background="?attr/colorSurfaceVariant"
        android:fontFamily="monospace"
        android:padding="@dimen/gm_spacing_2"
        android:textColor="?android:attr/textColorPrimary"
        android:textIsSelectable="true"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_radix_dec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gm_spacing_1"
        android:background="?attr/colorSurfaceVariant"
        android:fontFamily="monospace"
        android:padding="@dimen/gm_spacing_2"
        android:textColor="?android:attr/textColorPrimary"
        android:textIsSelectable="true"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_radix_hex"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gm_spacing_1"
        android:background="?attr/colorSurfaceVariant"
        android:fontFamily="monospace"
        android:padding="@dimen/gm_spacing_2"
        android:textColor="?android:attr/textColorPrimary"
        android:textIsSelectable="true"
        android:textSize="13sp" />
</LinearLayout>
