<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_read_clipboard"
        style="@style/Widget.GameMatrix.Button.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="读取剪贴板" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="8dp"
        android:background="?attr/colorSurfaceVariant"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_clipboard_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="点击读取..."
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:textIsSelectable="true" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/et_clipboard_set"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="输入要设置的内容..."
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_set_clipboard"
            style="@style/Widget.GameMatrix.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="设置" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_clear_clipboard"
        style="@style/Widget.GameMatrix.Button"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:text="清空剪贴板" />
</LinearLayout>