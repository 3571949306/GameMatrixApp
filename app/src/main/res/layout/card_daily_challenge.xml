<?xml version="1.0" encoding="utf-8"?>
<!-- Feature A: 每日挑战卡片 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_daily_challenge"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="8dp"
    android:padding="20dp"
    android:background="@drawable/bg_daily_challenge_card"
    android:elevation="3dp">

    <!-- 标题行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_daily_challenge"
            app:tint="@color/daily_challenge_card_text"
            android:contentDescription="@string/daily_challenge_title" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/daily_challenge_title"
            android:textColor="@color/daily_challenge_card_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_daily_challenge_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@color/daily_challenge_card_progress_bg"
            android:textColor="@color/daily_challenge_card_text"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="未完成" />
    </LinearLayout>

    <!-- 挑战描述 -->
    <TextView
        android:id="@+id/tv_daily_challenge_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/daily_challenge_card_text_secondary"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        tools:text="玩 3 局五子棋" />

    <!-- 进度条 -->
    <ProgressBar
        android:id="@+id/progress_daily_challenge"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/daily_challenge_card_text"
        android:progressBackgroundTint="@color/daily_challenge_card_progress_bg" />

    <!-- 进度数字 -->
    <TextView
        android:id="@+id/tv_daily_challenge_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/daily_challenge_card_text_secondary"
        android:textSize="12sp"
        tools:text="进度：0 / 3" />
</LinearLayout>
