<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/eye_care_bg">

    <!-- ============== Feature A: 每日挑战卡片（仅当 ACHIEVEMENT_V2 开启时显示） ============== -->
    <include
        android:id="@+id/card_daily_challenge_include"
        layout="@layout/card_daily_challenge"
        android:visibility="gone" />

    <!-- ============== Feature A: 连胜概览卡片 ============== -->
    <include
        android:id="@+id/card_streak_summary_include"
        layout="@layout/card_streak_summary"
        android:visibility="gone" />

    <!-- ============== Batch 10-4 (ACHIEVEMENT_PROGRESS_RING): 成就总览圆环卡片 ============== -->
    <LinearLayout
        android:id="@+id/ring_progress_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/gm_spacing_4"
        android:layout_marginEnd="@dimen/gm_spacing_4"
        android:layout_marginTop="@dimen/gm_spacing_3"
        android:padding="@dimen/gm_spacing_4"
        android:background="@color/eye_care_card"
        android:elevation="1dp"
        android:visibility="gone"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/achievement_ring_title"
            android:textSize="14sp"
            android:textColor="@color/eye_care_text_secondary"
            android:textStyle="bold" />

        <com.gamecenter.app.ui.AchievementProgressRingView
            android:id="@+id/ring_achievement_progress"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="@dimen/gm_spacing_2" />
    </LinearLayout>

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/gm_spacing_4"
        android:background="@color/eye_care_card"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/module_back"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/gm_spacing_1" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/gm_spacing_3"
            android:text="@string/achievement_center_title"
            android:textSize="20sp"
            android:textColor="@color/eye_care_text_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 总进度卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="@dimen/gm_spacing_4"
        android:padding="@dimen/gm_spacing_5"
        android:background="@color/eye_care_card"
        android:elevation="1dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/achievement_total_progress"
            android:textSize="14sp"
            android:textColor="@color/eye_care_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/gm_spacing_2">

            <TextView
                android:id="@+id/tv_total_unlocked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="36sp"
                android:textColor="@color/brand_primary"
                android:textStyle="bold"
                tools:text="42" />

            <TextView
                android:id="@+id/tv_total_separator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="@color/eye_care_text_hint"
                android:layout_marginHorizontal="@dimen/gm_spacing_2"
                tools:text="/ 135" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_total"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="@dimen/gm_spacing_3"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@android:drawable/progress_horizontal" />

        <TextView
            android:id="@+id/tv_games_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gm_spacing_2"
            android:textSize="12sp"
            android:textColor="@color/eye_care_text_hint"
            tools:text="8 / 27 个游戏有成就进度" />

        <!-- P1-5 (ACHIEVEMENT_POINTS): 成就点数总览 -->
        <TextView
            android:id="@+id/tv_achievement_points"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gm_spacing_2"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            tools:text="总点数 320（铜5/银3/金2/铂0）" />
    </LinearLayout>

    <!-- 游戏成就列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_achievement_games"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/gm_spacing_4"
        android:clipToPadding="false"
        android:layout_marginTop="@dimen/gm_spacing_1" />

</LinearLayout>
