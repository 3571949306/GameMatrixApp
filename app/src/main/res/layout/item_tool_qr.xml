<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="输入文本或URL">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_qr_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine" android:maxLines="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_generate_qr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="生成二维码" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_scan_qr" style="@style/Widget.GameMatrix.Button.Tonal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="扫描二维码" />
    </LinearLayout>

    <ImageView android:id="@+id/iv_qr_code" android:layout_width="200dp" android:layout_height="200dp" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:scaleType="fitCenter" android:src="@drawable/ic_qr_placeholder" android:visibility="gone" />
</LinearLayout>
