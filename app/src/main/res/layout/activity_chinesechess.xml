<?xml version="1.0" encoding="utf-8"?>
<!-- 中国象棋主布局 v3.0（2026-07-23 UI 重设计）：
     棋盘居中，其他内容以浮动面板形式显示 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/chess_main_bg"
    android:fitsSystemWindows="true">

    <!-- 棋盘视图（居中，占据最大空间） -->
    <com.gamecenter.app.games.chinesechess.ChineseChessView
        android:id="@+id/chess_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- 黑方信息栏（顶部悬浮） -->
    <LinearLayout
        android:id="@+id/bar_black_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="@dimen/gm_spacing_3"
        android:layout_marginTop="@dimen/gm_spacing_2"
        android:background="@drawable/chess_player_bar_bg"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="@dimen/gm_spacing_2"
        android:visibility="gone">

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/black" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gm_spacing_2"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_black_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chinese_chess_black_player"
                android:textColor="@color/chess_player_bar_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/black_captured_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_black_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="10:00"
            android:textColor="@color/chess_timer_normal"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 红方信息栏（底部悬浮） -->
    <LinearLayout
        android:id="@+id/bar_red_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/gm_spacing_3"
        android:layout_marginBottom="@dimen/gm_spacing_2"
        android:background="@drawable/chess_player_bar_bg"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="@dimen/gm_spacing_2"
        android:visibility="gone">

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@color/chinese_chess_red" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gm_spacing_2"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_red_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chinese_chess_red_player"
                android:textColor="@color/chess_player_bar_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/red_captured_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_red_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="10:00"
            android:textColor="@color/chess_timer_normal"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 走法历史面板（右侧浮动，默认隐藏，点击展开） -->
    <LinearLayout
        android:id="@+id/history_panel"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="@dimen/gm_spacing_1"
        android:background="@drawable/chess_history_bg"
        android:elevation="4dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="棋谱"
            android:textColor="@color/chess_history_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/gm_spacing_1"
            android:background="@color/chess_card_border"
            android:alpha="0.3" />

        <ScrollView
            android:id="@+id/history_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tv_move_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="@string/chinese_chess_no_moves"
                android:textColor="@color/chess_history_subtext"
                android:textSize="9sp" />

        </ScrollView>

    </LinearLayout>

    <!-- 控制按钮组（底部中央浮动） -->
    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="60dp"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_undo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/chess_control_btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="悔"
            android:textColor="@color/chess_control_btn_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_hint"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/chess_hint_btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="💡"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btn_draw"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/chess_resign_btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="和"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_resign"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/chess_resign_btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="认"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_restart"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/chess_control_btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🔄"
            android:textSize="20sp" />

    </LinearLayout>

    <!-- 难度选择面板（居中覆盖） -->
    <ScrollView
        android:id="@+id/difficulty_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/gm_spacing_5"
            android:paddingVertical="@dimen/gm_spacing_8">

            <LinearLayout
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:background="@drawable/chess_main_card_bg"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="@dimen/gm_spacing_5">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/chinese_chess_title"
                    android:textColor="@color/chess_title_text"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="2dp"
                    android:text="@string/chinese_chess_subtitle"
                    android:textColor="@color/chess_subtitle_text"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/gm_spacing_3"
                    android:layout_marginBottom="@dimen/gm_spacing_3"
                    android:alpha="0.4"
                    android:background="@color/chess_card_border" />

                <TextView
                    android:id="@+id/tv_difficulty_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/chinese_chess_select_difficulty"
                    android:textColor="@color/chess_subtitle_text"
                    android:textSize="13sp" />

                <!-- 难度按钮行1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btn_difficulty_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/gm_spacing_1"
                        android:layout_weight="1"
                        android:background="@drawable/chess_difficulty_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/gm_spacing_2">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="10dp"
                            android:contentDescription="@string/chinese_chess_difficulty_easy"
                            android:src="@drawable/chess_stars_1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gm_spacing_1"
                            android:text="@string/chinese_chess_difficulty_easy"
                            android:textColor="@color/chess_difficulty_unselected"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_difficulty_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/gm_spacing_1"
                        android:layout_weight="1"
                        android:background="@drawable/chess_difficulty_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/gm_spacing_2">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="10dp"
                            android:contentDescription="@string/chinese_chess_difficulty_normal"
                            android:src="@drawable/chess_stars_2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gm_spacing_1"
                            android:text="@string/chinese_chess_difficulty_normal"
                            android:textColor="@color/chess_difficulty_unselected"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_difficulty_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/gm_spacing_1"
                        android:layout_weight="1"
                        android:background="@drawable/chess_difficulty_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/gm_spacing_2">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="10dp"
                            android:contentDescription="@string/chinese_chess_difficulty_hard"
                            android:src="@drawable/chess_stars_3" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gm_spacing_1"
                            android:text="@string/chinese_chess_difficulty_hard"
                            android:textColor="@color/chess_difficulty_unselected"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 难度按钮行2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gm_spacing_2"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btn_difficulty_4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/gm_spacing_1"
                        android:layout_weight="1"
                        android:background="@drawable/chess_difficulty_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/gm_spacing_2">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="10dp"
                            android:contentDescription="@string/chinese_chess_difficulty_master"
                            android:src="@drawable/chess_stars_4" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gm_spacing_1"
                            android:text="@string/chinese_chess_difficulty_master"
                            android:textColor="@color/chess_difficulty_unselected"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/btn_start_game"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/chess_start_btn_bg"
                    android:clickable="true"
                    android:elevation="4dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/chinese_chess_start"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
