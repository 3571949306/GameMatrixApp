<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/chess_main_bg"
    android:paddingTop="28dp">

    <!-- 棋盘视图（游戏中可见） -->
    <com.gamecenter.app.games.chinesechess.ChineseChessView
        android:id="@+id/chess_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <!-- 难度选择主面板：中央卡片样式（初始可见） -->
    <ScrollView
        android:id="@+id/difficulty_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <!-- 中央卡片：包裹标题+难度+开始按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/chess_main_card_bg"
                android:elevation="6dp"
                android:padding="20dp">

                <!-- 标题区 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/chinese_chess_title"
                    android:textColor="@color/chess_title_text"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="2dp"
                    android:text="@string/chinese_chess_subtitle"
                    android:textColor="@color/chess_subtitle_text"
                    android:textSize="13sp" />

                <!-- 分隔线 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/chess_card_border"
                    android:alpha="0.4" />

                <!-- 难度标签 -->
                <TextView
                    android:id="@+id/tv_difficulty_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/chinese_chess_select_difficulty"
                    android:textColor="@color/chess_subtitle_text"
                    android:textSize="14sp" />

                <!-- 难度2×2宫格 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/btn_difficulty_1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/chess_difficulty_selector"
                            android:padding="10dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="12dp"
                                android:src="@drawable/chess_stars_1"
                                android:contentDescription="@string/chinese_chess_difficulty_easy" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/chinese_chess_difficulty_easy"
                                android:textColor="@color/chess_difficulty_unselected"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/chinese_chess_difficulty_easy_desc"
                                android:textColor="@color/chess_difficulty_unselected"
                                android:alpha="0.7"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btn_difficulty_2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/chess_difficulty_selector"
                            android:padding="10dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="12dp"
                                android:src="@drawable/chess_stars_2"
                                android:contentDescription="@string/chinese_chess_difficulty_normal" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/chinese_chess_difficulty_normal"
                                android:textColor="@color/chess_difficulty_unselected"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/chinese_chess_difficulty_normal_desc"
                                android:textColor="@color/chess_difficulty_unselected"
                                android:alpha="0.7"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/btn_difficulty_3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/chess_difficulty_selector"
                            android:padding="10dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="12dp"
                                android:src="@drawable/chess_stars_3"
                                android:contentDescription="@string/chinese_chess_difficulty_hard" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/chinese_chess_difficulty_hard"
                                android:textColor="@color/chess_difficulty_unselected"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/chinese_chess_difficulty_hard_desc"
                                android:textColor="@color/chess_difficulty_unselected"
                                android:alpha="0.7"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btn_difficulty_4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/chess_difficulty_selector"
                            android:padding="10dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="12dp"
                                android:src="@drawable/chess_stars_4"
                                android:contentDescription="@string/chinese_chess_difficulty_master" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/chinese_chess_difficulty_master"
                                android:textColor="@color/chess_difficulty_unselected"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/chinese_chess_difficulty_master_desc"
                                android:textColor="@color/chess_difficulty_unselected"
                                android:alpha="0.7"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- 开始游戏按钮 -->
                <TextView
                    android:id="@+id/btn_start_game"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/chess_start_btn_bg"
                    android:gravity="center"
                    android:text="@string/chinese_chess_start"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="4dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- 游戏控制面板（仅游戏中可见） -->
    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_undo"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/chess_control_btn_bg"
            android:gravity="center"
            android:text="@string/chinese_chess_undo"
            android:textColor="@color/chess_control_btn_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp" />

        <TextView
            android:id="@+id/btn_restart"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/chess_control_btn_bg"
            android:gravity="center"
            android:text="@string/chinese_chess_restart"
            android:textColor="@color/chess_control_btn_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp" />

    </LinearLayout>

</LinearLayout>
