<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="@dimen/gm_spacing_3"
    android:paddingTop="@dimen/gm_spacing_1"
    android:paddingEnd="@dimen/gm_spacing_3"
    android:paddingBottom="@dimen/gm_spacing_1">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gm_spacing_8"
        app:cardBackgroundColor="@color/ai_chat_user_container"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        tools:ignore="MissingPrefix">

        <TextView
            android:id="@+id/tv_msg_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:maxWidth="@dimen/ai_chat_user_max_width"
            android:paddingStart="@dimen/gm_spacing_3"
            android:paddingTop="@dimen/gm_spacing_2"
            android:paddingEnd="@dimen/gm_spacing_3"
            android:paddingBottom="@dimen/gm_spacing_2"
            android:textColor="@color/ai_chat_user_content"
            android:textSize="14sp"
            tools:text="用户发送的消息内容" />
    </com.google.android.material.card.MaterialCardView>

    <ImageButton
        android:id="@+id/btn_msg_favorite"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/ai_chat_favorite"
        android:padding="14dp"
        android:src="@android:drawable/btn_star_big_off"
        app:tint="@color/ai_chat_action_tint" />

</LinearLayout>
