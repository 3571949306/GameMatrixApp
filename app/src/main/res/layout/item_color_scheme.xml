<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="10dp"
    android:paddingHorizontal="@dimen/gm_spacing_1"
    android:background="?attr/selectableItemBackground">

    <View
        android:id="@+id/v_color_primary"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/color_circle_bg" />

    <View
        android:id="@+id/v_color_secondary"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/color_circle_bg" />

    <View
        android:id="@+id/v_color_accent"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/color_circle_bg" />

    <TextView
        android:id="@+id/tv_scheme_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/gm_spacing_4"
        android:textSize="15sp"
        android:textColor="?android:attr/textColorPrimary" />

    <RadioButton
        android:id="@+id/rb_selected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false" />

</LinearLayout>
