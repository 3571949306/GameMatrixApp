<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <com.gamecenter.app.games.doudizhu.DouDiZhuTableView
        android:id="@+id/tableView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/topStatusBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvLandlordIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="地主："
            android:textColor="#FF6B35"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTurnIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="轮到："
            android:textColor="#B0BEC5"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已连接"
            android:textColor="#4CAF50"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/lobbyContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvServerInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="房间信息"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRoomList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="12dp"
            android:layout_weight="1"
            android:background="#333333"
            android:padding="8dp"
            android:text="搜索房间中..."
            android:textColor="#B0BEC5"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCreateRoom"
                android:layout_width="100dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_game_primary"
                android:text="创建房间"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnJoinRoom"
                android:layout_width="100dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_game_secondary"
                android:text="加入房间"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCopyRoomAddress"
                android:layout_width="100dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_game_secondary"
                android:text="复制地址"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnStartGame"
                android:layout_width="100dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_game_primary"
                android:text="开始游戏"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnDisconnect"
                android:layout_width="80dp"
                android:layout_height="36dp"
                android:background="@drawable/btn_game_secondary"
                android:text="退出"
                android:textColor="@color/white"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/handCardArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.35"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:clickable="false"
        android:focusable="false"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="2dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/handCardArea"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/bidButtonLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <Button
                android:id="@+id/btnCallLandlord"
                android:layout_width="60dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_game_primary"
                android:ellipsize="none"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="叫地主"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNoCall"
                android:layout_width="60dp"
                android:layout_height="32dp"
                android:background="@drawable/btn_game_secondary"
                android:ellipsize="none"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="不叫"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/playButtonLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <Button
                android:id="@+id/btnPlayCard"
                android:layout_width="60dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_game_primary"
                android:ellipsize="none"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="出牌"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnHint"
                android:layout_width="60dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_game_secondary"
                android:ellipsize="none"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="提示"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPass"
                android:layout_width="60dp"
                android:layout_height="32dp"
                android:background="@drawable/btn_game_secondary"
                android:ellipsize="none"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="不出"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/chatContainer"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:background="#44000000"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topStatusBar"
        tools:visibility="visible">

        <ScrollView
            android:id="@+id/chatScrollView"
            android:layout_width="match_parent"
            android:layout_height="68dp">

            <TextView
                android:id="@+id/tvChatMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#E0E0E0"
                android:textSize="10sp" />

        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etChatInput"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="#444444"
                android:hint="聊天"
                android:paddingHorizontal="4dp"
                android:textColor="@color/white"
                android:textColorHint="#888888"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnSendChat"
                android:layout_width="40dp"
                android:layout_height="28dp"
                android:background="@drawable/btn_game_secondary"
                android:text="发"
                android:textColor="@color/white"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/gameOverDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvGameOverTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="游戏结束"
            android:textColor="#FF6B35"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGameOverResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="恭喜获胜！"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvScoreDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="本局得分：+50"
            android:textColor="#E0E0E0"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPlayAgain"
                android:layout_width="100dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_game_primary"
                android:text="再来一局"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnExit"
                android:layout_width="100dp"
                android:layout_height="44dp"
                android:background="@drawable/btn_game_secondary"
                android:text="退出"
                android:textColor="@color/white"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
