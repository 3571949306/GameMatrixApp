{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamematrix.local/schemas/catalog-v2.schema.json",
  "title": "GameMatrix Multi-runtime Module Catalog V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "modules"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "catalogVersion": { "type": "integer", "minimum": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string" },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sha256"],
      "properties": {
        "fileName": { "type": "string", "minLength": 1 },
        "fileSize": { "type": "integer", "minimum": 0 },
        "downloadUrl": { "$ref": "#/$defs/httpsUrl" },
        "fallbackUrl": { "$ref": "#/$defs/httpsUrl" },
        "githubUrl": { "$ref": "#/$defs/httpsUrl" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "signature": { "type": "string" }
      },
      "anyOf": [
        { "required": ["downloadUrl"] },
        { "required": ["fallbackUrl"] },
        { "required": ["githubUrl"] }
      ]
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "$ref": "#/$defs/httpsUrl" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "signature": { "type": "string" }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "navigationContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot"],
      "properties": {
        "slot": { "enum": ["bottom_nav", "games_hall", "tools_grid", "store_category", "settings"] },
        "title": { "type": "string" },
        "icon": { "enum": ["games", "browser", "tools", "ai", "vpn", "profile", "extension"] },
        "order": { "type": "integer" },
        "enabled": { "type": "boolean" }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "versionName", "versionCode", "runtimeType", "deliveryType"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "shortDescription": { "type": "string" },
        "description": { "type": "string" },
        "versionName": { "type": "string", "minLength": 1 },
        "versionCode": { "type": "integer", "minimum": 1 },
        "runtimeType": {
          "enum": ["flutter", "web", "asset", "android", "native_service", "unity"]
        },
        "deliveryType": { "enum": ["builtin", "apk", "zip", "content"] },
        "route": { "type": "string" },
        "entryClass": { "type": "string" },
        "entry": { "type": "string" },
        "serviceType": { "type": "string" },
        "launcherId": { "type": "string" },
        "enabled": { "type": "boolean" },
        "required": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "sortOrder": { "type": "integer" },
        "minHostVersionCode": { "type": "integer", "minimum": 0 },
        "maxHostVersionCode": { "type": "integer", "minimum": 0 },
        "category": { "type": "string" },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "permissionsDescription": { "type": "array", "items": { "$ref": "#/$defs/permission" } },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "screenshots": { "type": "array", "items": { "$ref": "#/$defs/httpsUrl" } },
        "changelog": { "type": "array", "items": { "type": "string" } },
        "navigationContribution": { "$ref": "#/$defs/navigationContribution" },
        "package": { "$ref": "#/$defs/package" },
        "assets": { "$ref": "#/$defs/assets" }
      },
      "allOf": [
        {
          "if": { "properties": { "deliveryType": { "not": { "const": "builtin" } } } },
          "then": { "required": ["package"] }
        },
        {
          "if": { "properties": { "runtimeType": { "const": "flutter" } } },
          "then": {
            "required": ["route"],
            "properties": { "deliveryType": { "const": "builtin" } }
          }
        },
        {
          "if": { "properties": { "runtimeType": { "const": "web" } } },
          "then": {
            "required": ["entry"],
            "properties": { "deliveryType": { "enum": ["builtin", "zip"] } }
          }
        },
        {
          "if": { "properties": { "runtimeType": { "const": "asset" } } },
          "then": { "properties": { "deliveryType": { "enum": ["builtin", "zip"] } } }
        },
        {
          "if": {
            "properties": {
              "runtimeType": { "const": "android" },
              "deliveryType": { "const": "apk" }
            },
            "required": ["runtimeType", "deliveryType"]
          },
          "then": { "required": ["entryClass"] }
        },
        {
          "if": { "properties": { "runtimeType": { "const": "android" } } },
          "then": { "properties": { "deliveryType": { "enum": ["builtin", "apk"] } } }
        },
        {
          "if": {
            "properties": {
              "runtimeType": { "const": "native_service" },
              "deliveryType": { "const": "apk" }
            },
            "required": ["runtimeType", "deliveryType"]
          },
          "then": { "required": ["serviceType", "entryClass"] }
        },
        {
          "if": { "properties": { "runtimeType": { "const": "native_service" } } },
          "then": {
            "required": ["serviceType"],
            "properties": { "deliveryType": { "enum": ["builtin", "apk"] } }
          }
        },
        {
          "if": { "properties": { "runtimeType": { "const": "unity" } } },
          "then": {
            "required": ["launcherId"],
            "properties": { "deliveryType": { "enum": ["builtin", "apk", "content"] } }
          }
        }
      ]
    }
  }
}
