{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamematrix.local/schemas/catalog-v2.schema.json",
  "title": "GameMatrix Multi-runtime Module Catalog V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "modules"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "catalogVersion": { "type": "integer", "minimum": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string" },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sha256"],
      "properties": {
        "fileName": { "type": "string", "minLength": 1 },
        "fileSize": { "type": "integer", "minimum": 0 },
        "downloadUrl": { "$ref": "#/$defs/httpsUrl" },
        "fallbackUrl": { "$ref": "#/$defs/httpsUrl" },
        "githubUrl": { "$ref": "#/$defs/httpsUrl" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "signature": { "type": "string" }
      },
      "anyOf": [
        { "required": ["downloadUrl"] },
        { "required": ["fallbackUrl"] },
        { "required": ["githubUrl"] }
      ]
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "$ref": "#/$defs/httpsUrl" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "signature": { "type": "string" }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "navigationContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot"],
      "properties": {
        "slot": { "enum": ["bottom_nav", "games_hall", "tools_grid", "store_category", "settings"] },
        "title": { "type": "string" },
        "icon": { "enum": ["games", "browser", "tools", "ai", "vpn", "profile", "extension"] },
        "order": { "type": "integer" },
        "enabled": { "type": "boolean" }
      }
    },
    "moduleDetail": {
      "type": "object",
      "additionalProperties": false,
      "description": "模块详情（#11.1）：安装前向用户完整披露模块信息",
      "properties": {
        "valueDescription": { "type": "string", "description": "价值描述：模块解决什么问题、给用户带来什么结果" },
        "audience": { "type": "string", "description": "目标受众：如学生、开发者、游戏玩家" },
        "offlineCapability": { "type": "string", "description": "离线能力：是否可离线使用，哪些功能需要联网" },
        "updateImpact": { "type": "string", "description": "更新影响：更新时会改动什么（数据/配置/缓存）" },
        "uninstallImpact": { "type": "string", "description": "卸载影响：卸载后会遗留什么（数据/配置）" },
        "highlights": { "type": "array", "items": { "type": "string" }, "description": "亮点列表：3-5 条核心功能要点" },
        "limitations": { "type": "array", "items": { "type": "string" }, "description": "已知限制：如性能、兼容性、使用约束" }
      }
    },
    "privacyCard": {
      "type": "object",
      "additionalProperties": false,
      "description": "隐私卡（#11.2）：安装前向用户明示模块的数据行为，与 #23 数据与连接中心共用",
      "properties": {
        "localData": { "type": "string", "description": "本地数据：模块在设备上存储了什么" },
        "cloudData": { "type": "string", "description": "云端数据：模块会向云端发送什么内容" },
        "networkDomains": { "type": "array", "items": { "type": "string" }, "description": "网络域：模块连接的域名/IP 列表" },
        "syncLocation": { "type": "string", "description": "同步位置：数据同步到哪（如 WebDAV、厂商云、无）" },
        "retentionPeriod": { "type": "string", "description": "保存期限：数据保留多久（如 '会话级'/'30 天'/'直到卸载'）" },
        "deletionMethod": { "type": "string", "description": "删除方式：如何删除数据（如 '卸载即清除'/'设置内一键清除'）" }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "versionName", "versionCode", "runtimeType", "deliveryType"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "shortDescription": { "type": "string" },
        "description": { "type": "string" },
        "versionName": { "type": "string", "minLength": 1 },
        "versionCode": { "type": "integer", "minimum": 1 },
        "runtimeType": {
          "enum": ["flutter", "web", "asset", "android", "native_service", "unity"]
        },
        "deliveryType": { "enum": ["builtin", "apk", "zip", "content"] },
        "route": { "type": "string" },
        "entryClass": { "type": "string" },
        "entry": { "type": "string" },
        "serviceType": { "type": "string" },
        "launcherId": { "type": "string" },
        "enabled": { "type": "boolean" },
        "required": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "sortOrder": { "type": "integer" },
        "minHostVersionCode": { "type": "integer", "minimum": 0 },
        "maxHostVersionCode": { "type": "integer", "minimum": 0 },
        "category": { "type": "string" },
        "storeCategory": {
          "type": "string",
          "enum": ["entertainment_versus", "learning_organization", "reading_browsing", "text_creation", "device_network", "personalization"],
          "description": "商店结果分类：按用户完成的任务类型组织模块"
        },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "permissionsDescription": { "type": "array", "items": { "$ref": "#/$defs/permission" } },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "screenshots": { "type": "array", "items": { "$ref": "#/$defs/httpsUrl" } },
        "changelog": { "type": "array", "items": { "type": "string" } },
        "navigationContribution": { "$ref": "#/$defs/navigationContribution" },
        "package": { "$ref": "#/$defs/package" },
        "assets": { "$ref": "#/$defs/assets" },
        "details": { "$ref": "#/$defs/moduleDetail", "description": "模块详情（可选但建议填写）" },
        "privacy": { "$ref": "#/$defs/privacyCard", "description": "隐私卡（可选但建议填写）" }
      },
      "allOf": [
        {
          "if": { "properties": { "deliveryType": { "not": { "const": "builtin" } } } },
          "then": { "required": ["package"] }
        },
        {
          "if": { "properties": { "runtimeType": { "const": "flutter" } } },
          "then": {
            "required": ["route"],
            "properties": { "deliveryType": { "const": "builtin" } }
          }
        },
        {
          "if": { "properties": { "runtimeType": { "const": "web" } } },
          "then": {
            "required": ["entry"],
            "properties": { "deliveryType": { "enum": ["builtin", "zip"] } }
          }
        },
        {
          "if": { "properties": { "runtimeType": { "const": "asset" } } },
          "then": { "properties": { "deliveryType": { "enum": ["builtin", "zip"] } } }
        },
        {
          "if": {
            "properties": {
              "runtimeType": { "const": "android" },
              "deliveryType": { "const": "apk" }
            },
            "required": ["runtimeType", "deliveryType"]
          },
          "then": { "required": ["entryClass"] }
        },
        {
          "if": { "properties": { "runtimeType": { "const": "android" } } },
          "then": { "properties": { "deliveryType": { "enum": ["builtin", "apk"] } } }
        },
        {
          "if": {
            "properties": {
              "runtimeType": { "const": "native_service" },
              "deliveryType": { "const": "apk" }
            },
            "required": ["runtimeType", "deliveryType"]
          },
          "then": { "required": ["serviceType", "entryClass"] }
        },
        {
          "if": { "properties": { "runtimeType": { "const": "native_service" } } },
          "then": {
            "required": ["serviceType"],
            "properties": { "deliveryType": { "enum": ["builtin", "apk"] } }
          }
        },
        {
          "if": { "properties": { "runtimeType": { "const": "unity" } } },
          "then": {
            "required": ["launcherId"],
            "properties": { "deliveryType": { "enum": ["builtin", "apk", "content"] } }
          }
        }
      ]
    }
  }
}
